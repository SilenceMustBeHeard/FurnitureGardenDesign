@model FurnitureGardenDesign.Web.ViewModels.Category.CategoryViewModelCreate

@{
    ViewData["Title"] = "Add New Category";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-6 col-md-8 col-12">

            <div class="glass p-4 p-md-5 rounded-7 shadow-lg">

                <h2 class="text-center mb-4 hero-title">
                    <i class="bi bi-tags me-2"></i> Add New Category
                </h2>

                <form asp-controller="Category" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control glass-input" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" rows="3" class="form-control glass-input"></textarea>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-glass">← Back</a>
                        <button type="submit" class="btn btn-primary-glass">
                            Add Category
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
