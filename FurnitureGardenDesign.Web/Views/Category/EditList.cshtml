@model IEnumerable<FurnitureGardenDesign.Web.ViewModels.Category.CategoryViewModelList>

@{
    ViewData["Title"] = "Edit Categories";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-9 col-md-11 col-12">

            <div class="glass p-4 p-md-5 rounded-7 shadow-lg">

                <h2 class="text-center mb-4 hero-title">
                    <i class="bi  me-2"></i> Edit Categories
                </h2>

                @if (!Model.Any())
                {
                    <div class="glass-card p-4 text-center text-muted">
                        No categories loaded yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle glass-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Active</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model)
                                {
                                    <tr>
                                        <td>@c.Name</td>
                                        <td>
                                            <span class="badge @(c.IsActive ? "bg-success-glass" : "bg-danger-glass")">
                                                @(c.IsActive ? "Yes" : "No")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-area="Admin"
                                               asp-controller="Category"
                                               asp-action="Edit"
                                               asp-route-id="@c.Id"
                                               class="btn btn-sm btn-primary-glass">
                                                Edit
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="mt-4">
                    <a asp-action="Create" class="btn btn-outline-glass">
                        + Add Category
                    </a>
                </div>

            </div>

        </div>
    </div>
</div>
