@model IEnumerable<FurnitureGardenDesign.Web.ViewModels.Category.CategoryViewModelList>

@{
    ViewData["Title"] = "Edit Categories";
}

<div class="container-fluid">

    <h2 class="fw-bold text-warning mb-4">Edit Categories</h2>

    @if (!Model.Any())
    {
        <div class="glass-card p-4 text-center text-muted">
            No categories loaded yet.
        </div>
    }
    else
    {
        <div class="glass-card p-4">
            <table class="table table-hover text-light">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Active</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td>@(c.IsActive ? "Yes" : "No")</td>
                            <td class="text-end">
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-area="Admin"
                                       asp-controller="Category"
                                       asp-action="Edit"
                                       asp-route-id="@c.Id"
                                       class="btn btn-sm btn-primary-glass">
                                        Edit
                                    </a>
                                }
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>
