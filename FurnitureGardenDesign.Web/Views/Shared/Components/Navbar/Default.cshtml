@using FurnitureGardenDesign.Web.ViewModels
@model NavbarButtonsViewModel

<div class="d-flex align-items-center gap-2">

    @* Always visible buttons *@
    <a class="btn btn-outline-glass btn-sm"
       asp-controller="Home"
       asp-action="About">
        About
    </a>

    <a class="btn btn-outline-glass btn-sm"
       asp-controller="Home"
       asp-action="Privacy">
        Privacy
    </a>
    @* Role-based buttons *@

    @if (Model.IsAdmin)
    {
       @* Admin *@
        <a class="btn btn-warning-glass"
           asp-area="Admin"
           asp-controller="Category"
           asp-action="Create">
            Add Category
        </a>

        <a class="btn btn-outline-glass"
           asp-controller="Orders"
           asp-action="Manage">
            Orders (@Model.PendingOrdersCount)
        </a>
    }
    else if (Model.IsManager)
    {
      @*   Manager *@
        <a class="btn btn-primary-glass"
           asp-controller="Catalog"
           asp-action="Index">
            Catalogue
        </a>

        <a class="btn btn-outline-glass"
           asp-controller="Orders"
           asp-action="Manage">
            Orders (@Model.PendingOrdersCount)
        </a>
    }
    else if (Model.IsUser)
    {
        
     @* Registered User *@  
        <a class="btn btn-primary-glass"
           asp-controller="Catalog"
           asp-action="Index">
            Catalogue
        </a>

        <a class="btn btn-outline-glass"
           asp-controller="Orders"
           asp-action="Create">
            New Order
        </a>
    }
    else
    {
        @* Guest *@
        <a class="btn btn-primary-glass"
           asp-controller="Catalog"
           asp-action="Explore">
            Catalogue
        </a>
    }
</div>
