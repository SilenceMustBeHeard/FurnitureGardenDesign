<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Furniture &amp; Garden Design</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm glass-nav navbar-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    Furniture &amp; Garden Design
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- central buttons all roles -->
                    <div class="d-flex align-items-center gap-2 mx-auto">
                        @await Component.InvokeAsync("Navbar")
                    </div>

                    <!--right menu acc + theme-->
                    <div class="d-flex align-items-center gap-2">
                        <button id="themeToggle" class="btn btn-outline-glass btn-sm" title="Toggle theme">🌙</button>

                        <div class="dropdown">
                            <button class="btn btn-primary-glass dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                Account
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @await Component.InvokeAsync("AccountMenu")
                            </ul>

                        </div>
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="container mt-4">
                    <div class="alert alert-success glass text-center shadow-sm">
                        <i class="bi bi-check-circle me-2"></i>
                        @TempData["SuccessMessage"]
                    </div>
                </div>
            }


            @RenderBody()
        </main>
    </div>

    <footer class="glass-footer border-top footer text-muted text-center">
        <div class="container">
            &copy; 2025 - Furniture &amp; Garden Design
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
