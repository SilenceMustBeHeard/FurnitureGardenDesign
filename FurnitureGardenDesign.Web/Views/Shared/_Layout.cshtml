<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Furniture &amp; Garden Design</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm glass-nav navbar-dark border-bottom mb-3">
            <div class="container-fluid">

              @* Left/Logo *@
                <div class="d-flex align-items-center gap-3">
                    <a class="navbar-brand logo-wrapper"
                       asp-controller="Home"
                       asp-action="Index">

                        <svg class="fgd-logo" width="320" height="48" viewBox="0 0 320 48">
                            <text x="0" y="34" class="logo-text">
                                Furniture &amp; Garden Design
                            </text>
                        </svg>
                    </a>

                    <a class="btn btn-outline-glass btn-sm" asp-controller="Home" asp-action="About">About</a>
                    <a class="btn btn-outline-glass btn-sm" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                  @*  Center/Navbar *@
                    <div class="mx-auto d-flex gap-4">
                        @await Component.InvokeAsync("Navbar")
                    </div>

                  @* Right/Account menu *@
                    <div class="d-flex gap-2">
                        <button id="themeToggle" class="btn btn-outline-glass btn-sm">🌙</button>

                        <div class="dropdown">
                            <button class="btn btn-primary-glass dropdown-toggle" data-bs-toggle="dropdown">
                                Account
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @await Component.InvokeAsync("AccountMenu")
                            </ul>
                        </div>
                    </div>

                </div>
            </div>
        </nav>
    </header>

       @* Scene *@
    <div class="scene-wrapper">
        <div class="scene-bg"></div>

        <div class="container scene-content">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="glass-footer text-center text-muted border-top">
        <div class="container">&copy; 2025 - Furniture &amp; Garden Design</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
