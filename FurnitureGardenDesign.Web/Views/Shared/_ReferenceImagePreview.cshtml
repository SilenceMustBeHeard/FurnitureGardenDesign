@model string
@{
    bool isDirectImage = !string.IsNullOrWhiteSpace(Model)
        && (Model.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase)
            || Model.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase)
            || Model.EndsWith(".png", StringComparison.OrdinalIgnoreCase)
            || Model.EndsWith(".webp", StringComparison.OrdinalIgnoreCase)
            || Model.EndsWith(".gif", StringComparison.OrdinalIgnoreCase));
}

@if (!string.IsNullOrWhiteSpace(Model))
{
    if (isDirectImage)
    {
        <div class="text-center mb-3">
            <img src="@Url.Action("ProxyImage", "OrdersManagement", new { url = Model })"
                 class="img-fluid rounded shadow-lg details-img"
                 style="max-height:500px;object-fit:contain;"
                 alt="Reference Image"
                 onerror="handleImageError(this)" />

            <div class="mt-2 small text-muted">
                <a href="@Model" target="_blank">Original Link</a>
            </div>
        </div>
    }
    else
    {
        <div class="webpage-card glass-card p-4 text-center mb-3">
            <i class="bi bi-link-45deg" style="font-size: 3rem; color: #c09a6c;"></i>
            <h5 class="mt-3">Webpage Link Provided</h5>
            <p class="text-muted small">The client shared a product page instead of an image.</p>

            <div class="d-flex gap-2 justify-content-center mt-3">
                <a href="@Model" target="_blank" class="btn btn-primary-glass">
                    <i class="bi bi-box-arrow-up-right"></i> Visit Page
                </a>
                <button type="button"
                        class="btn btn-outline-glass"
                        onclick="fetchPagePreview('@Model')">
                    <i class="bi bi-arrow-repeat"></i> Try Fetch Image
                </button>
            </div>

            <div id="previewContainer" class="mt-4" style="display:none;">
                <img id="fetchedImage" class="img-fluid rounded" style="max-height:300px;" />
            </div>
        </div>
    }
}
else
{
    <div class="text-muted fst-italic">
        No reference image provided.
    </div>
}
