@using FurnitureGardenDesign.Web.ViewModels.User

@model InboxMessageViewModel

<div class="glass-list-item p-3 mb-3 @(Model.IsRead ? "" : "border border-warning")">
    <div class="d-flex justify-content-between align-items-start">

        <div class="flex-grow-1">

            <small class="text-muted">
                @Model.CreatedOn.ToLocalTime().ToString("dd MMM yyyy HH:mm")
            </small>

            <div class="mt-3">
                <img src="@Model.DesignImage2DUrl"
                     class="img-fluid rounded shadow-sm"
                     style="max-height:150px;" />
            </div>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <p class="mt-3">@Model.Notes</p>
            }

            @if (!string.IsNullOrEmpty(Model.Model3DUrl))
            {
                <button class="btn btn-outline-glass btn-sm mt-2"
                        data-bs-toggle="modal"
                        data-bs-target="#model3DModal-@Model.Id">
                    View in 3D
                </button>
            }
        </div>

        @if (!Model.IsRead)
        {
            <form asp-action="MarkAsRead"
                  method="post"
                  class="ms-3">
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-outline-glass btn-sm">
                    Mark as read
                </button>
            </form>
        }
    </div>
</div>
@if (!string.IsNullOrEmpty(Model.Model3DUrl))
{
    <div class="modal fade"
         id="model3DModal-@Model.Id"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content glass-card border-0 rounded-4 text-light shadow-lg">

                <div class="modal-header border-0">
                    <h5 class="modal-title">3D Preview</h5>
                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body p-0">

                    <model-viewer src="@Model.Model3DUrl"
                                  camera-controls
                                  auto-rotate
                                  shadow-intensity="1"
                                  exposure="1"
                                  style="width:100%; height:70vh;">
                    </model-viewer>

                </div>
            </div>
        </div>
    </div>
}
