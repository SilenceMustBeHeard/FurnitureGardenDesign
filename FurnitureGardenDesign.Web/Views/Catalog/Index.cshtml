@model IEnumerable<FurnitureGardenDesign.Web.ViewModels.Catalog.CatalogDesignViewModel>

@{
    ViewData["Title"] = "Catalog";
    var currentPage = (int)ViewData["CurrentPage"];
    var pageSize = (int)ViewData["PageSize"];
    var totalItems = (int)ViewData["TotalItems"];
    var totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
}

<div class="card glass-card p-4 text-light">
    <h2 class="text-center mb-4 text-light fw-bold">Catalog</h2>


<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-lg-4 col-md-6">
            <div class="card glass-card h-100">
                <img src="@item.ImageUrl" class="card-img-top catalog-img" alt="@item.Title" />

                <div class="card-body d-flex flex-column text-light">
                    <h5 class="glass-title mb-2">@item.Title</h5>
                    <p class="glass-text-muted small mb-3">@item.Description</p>

                    <div class="mb-1">
                        <strong>Price:</strong>
                        <span class="text-success">@item.Price.ToString("F2")</span>
                    </div>

                    <div class="mb-3">
                        <strong>Rating:</strong>
                        <span class="text-warning">@item.AverageRating ★</span>
                        <span class="glass-text-muted small">(@item.ReviewCount)</span>
                    </div>

                    <div class="mt-auto d-flex gap-2 flex-wrap">




                        @* Toggle Favorite *@
                        @if (User.Identity.IsAuthenticated)
                        {
                            <form asp-controller="Catalog"
                                  asp-action="ToggleFavorite"
                                  method="post"
                                  class="favorite-form">

                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="returnUrl"
                                       value="@Url.Action("Details", "Catalog", new { id = item.Id })" />

                                <button type="submit"
                                        class="btn btn-sm @(item.IsFavorited ? "btn-danger" : "btn-outline-danger")"
                                        title="@(item.IsFavorited ? "Remove from favorites" : "Add to favorites")">

                                    @(item.IsFavorited ? "❤️ Remove from favorites" : "🤍 Add to favorites")
                                                               
                                                               
                                </button>

                            </form>
                            <a asp-controller="Review" asp-action="Write" asp-route-id="@item.Id" class="btn btn-outline-glass btn-sm">
                                Write Review
                            </a>
                        }
                     


                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-glass btn-sm">
                            View Details
                        </a>

                      
                    </div>
                </div>
            </div>
        </div>
    }
</div>
</div>

@* Show more/ Pagination *@
@if (currentPage < totalPages)
{
    <div class="text-center mt-4">
        <a class="btn btn-outline-glass"
           asp-action="Index"
           asp-route-page="@(currentPage + 1)"
           asp-route-pageSize="@pageSize">
            Show more
        </a>
    </div>
}


@section Scripts {
    <script>
       
        setTimeout(() => {
            const alerts = document.querySelectorAll(".alert");
            alerts.forEach(a => a.style.display = "none");
        }, 3500);
    </script>
}
