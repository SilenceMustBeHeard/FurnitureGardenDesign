@model IEnumerable<FurnitureGardenDesign.Web.ViewModels.Catalog.CatalogDesignViewModel>

@{
    ViewData["Title"] = "Catalog";

    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
    var pageSize = ViewData["PageSize"] as int? ?? 9;
    var totalItems = ViewData["TotalItems"] as int? ?? 0;
    var totalPages = (int)Math.Ceiling((double)totalItems / pageSize);

    bool isGuest = !User.Identity!.IsAuthenticated;
}
<div class="card glass-card h-100 shadow-sm">


<div class="container my-4">
    <h2 class="text-center mb-4 text-light fw-bold">Catalog</h2>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card glass-card h-100 shadow-sm">

                    <img src="@item.Image2DUrl" class="card-img-top catalog-img" alt="@item.Title" />

                    <div class="card-body d-flex flex-column text-light">
                        <h5 class="glass-title mb-2">@item.Title</h5>
                        <p class="glass-text-muted small mb-2">@item.Description</p>

                        <div class="d-flex justify-content-between mb-2">
                            <span><strong>Price:</strong> <span class="text-success">@item.Price.ToString("F2")</span></span>
                            <span><strong>Rating:</strong> <span class="text-warning">@item.AverageRating ★</span> <span class="small text-muted">(@item.ReviewCount)</span></span>
                        </div>

                        <div class="mt-auto d-flex flex-wrap gap-2">

                            @if (User.Identity.IsAuthenticated)
                            {
                                <form asp-controller="Catalog"
                                      asp-action="ToggleFavorite"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Catalog", new { id = item.Id })" />

                                    <button type="submit" class="btn btn-glass-fav @(item.IsFavorited ? "active" : "")">
                                        @(item.IsFavorited ? "❤️" : "🤍")
                                    </button>
                                </form>

                                <a asp-controller="Review" asp-action="Write" asp-route-id="@item.Id" class="btn btn-outline-glass btn-sm">
                                    Write Review
                                </a>
                            }

                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-glass btn-sm flex-grow-1">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* Pagination - logged only *@
    @if (!isGuest && totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-4">

            @* Back *@
            @if (currentPage > 1)
            {
                <a class="btn btn-outline-glass btn-sm"
                   asp-action="Index"
                   asp-route-page="@(currentPage - 1)"
                   asp-route-pageSize="@pageSize">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            }
            else
            {
                <div></div>
            }

            @* Next / Show more *@
            @if (currentPage < totalPages)
            {
                <a class="btn btn-outline-glass btn-sm"
                   asp-action="Index"
                   asp-route-page="@(currentPage + 1)"
                   asp-route-pageSize="@pageSize">
                    Show more <i class="bi bi-arrow-right"></i>
                </a>
            }
        </div>
    }
</div>
   </div>               
@section Scripts {
    <script>
        // Auto-dismiss alerts
        setTimeout(() => {
            document.querySelectorAll(".alert").forEach(alert => alert.style.display = "none");
        }, 3500);
    </script>
}
