@using FurnitureGardenDesign.Services.Core.Interfaces
@using FurnitureGardenDesign.Services.Core.Interfaces.Catalog
@model IEnumerable<FurnitureGardenDesign.Web.ViewModels.Catalog.CatalogDesignViewModel>

@{
    ViewData["Title"] = "Catalog";
    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
    var pageSize = ViewData["PageSize"] as int? ?? 9;
    var totalItems = ViewData["TotalItems"] as int? ?? 0;
    var totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
    var searchTerm = ViewData["SearchTerm"] as string ?? "";
    bool isGuest = ViewData["IsGuest"] as bool? ?? !User.Identity!.IsAuthenticated;
}

<div class="card glass-card p-4">
    <div class="container my-4">

        @* Header *@
        <div class="row mb-4">
            <div class="col-12">
                <div class="glass-card p-4 text-center">
                    <h1 class="display-6 fw-bold text-white mb-2">
                        <i class="bi bi-grid-3x3-gap-fill me-2"></i>Our Catalog
                    </h1>
                    <p class="text-muted mb-3">Explore our beautiful collection of designs</p>

                    @* Guest upgrade CTA *@
                    @if (isGuest)
                    {
                        <div class="row mt-5">
                            <div class="col-12 text-center">
                                <div class="glass-card p-4">
                                    <h4 class="text-white mb-3">
                                        <i class="bi bi-stars me-2"></i>Want to see more?
                                    </h4>
                                    <p class="mb-3">Create a free account to access our complete catalog of @(await GetTotalDesignsCount()) designs!</p>
                                    <div class="d-flex justify-content-center gap-3">
                                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary-glass">
                                            <i class="bi bi-person-plus me-2"></i>Create Account
                                        </a>
                                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-glass">
                                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @* Search bar - only for authenticated users *@
                        <div class="row justify-content-center">
                            <div class="col-md-8 col-lg-6">
                                <div class="d-flex gap-2">
                                    <div class="input-group glass-input-group flex-grow-1">
                                        <span class="input-group-text glass-input-prepend">
                                            <i class="bi bi-search"></i>
                                        </span>
                                        <input type="text"
                                               class="form-control glass-input"
                                               placeholder="Search catalog..."
                                               id="searchInput">
                                        <button class="btn btn-outline-glass" onclick="filterCatalog()" type="button">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Results count *@
        <div class="row mb-3">
            <div class="col-12">
                <p class="text-muted" id="resultsCount">
                    @if (isGuest)
                    {
                        <span>Showing <strong>@Model.Count()</strong> preview @(Model.Count() == 1 ? "design" : "designs")</span>
                    }
                    else
                    {
                        <span>Showing <strong id="visibleCount">@Model.Count()</strong> @(Model.Count() == 1 ? "design" : "designs")</span>
                    }
                </p>
            </div>
        </div>

        @* Catalog grid - FIXED WITH h-100 *@
        <div class="row g-4" id="catalogGrid">
            @if (!Model.Any())
            {
                <div class="col-12 text-center py-5">
                    <i class="bi bi-emoji-frown fs-1 text-muted"></i>
                    <h4 class="mt-3 text-light">No designs found</h4>
                    <p class="text-muted">The catalog is currently empty</p>
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <div class="col-xl-4 col-lg-6 col-md-6 catalog-item">
                        <div class="card glass-card user-catalog-card h-100">
                            
                            @* Image container - FIXED HEIGHT *@
                            <div class="position-relative">
                                <img src="@item.Image2DUrl"
                                     class="user-catalog-img w-100"
                                     alt="@item.Title"
                                     onerror="this.src='/images/placeholder.jpg'"
                                     style="height: 220px; object-fit: cover;">

                                @* Popular badge *@
                                @if (item.AverageRating >= 4.5)
                                {
                                    <div class="position-absolute top-0 start-0 p-2">
                                        <span class="badge bg-warning text-dark shadow-sm">
                                            <i class="bi bi-star-fill me-1"></i>POPULAR
                                        </span>
                                    </div>
                                }

                                @* 3d badge *@
                                @if (!string.IsNullOrEmpty(item.Model3DUrl))
                                {
                                    <div class="position-absolute bottom-0 end-0 p-2">
                                        <span class="badge bg-info shadow-sm">
                                            <i class="bi bi-cube me-1"></i>3D
                                        </span>
                                    </div>
                                }
                            </div>

                            @* Card body - FIXED WITH FLEX COLUMN *@
                            <div class="card-body d-flex flex-column">
                                @* Title *@
                                <h5 class="glass-title fw-bold mb-2">@item.Title</h5>

                                @* Description - FIXED HEIGHT *@
                                <p class="glass-text-muted small mb-2" style="min-height: 48px; max-height: 48px; overflow: hidden;">
                                    @item.Description
                                </p>

                                @* Materials - FIXED HEIGHT *@
                                <p class="glass-text-muted small mb-3" style="min-height: 48px; max-height: 48px; overflow: hidden;">
                                    @item.Materials
                                </p>

                                @* Price and rating *@
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <small class="text-muted d-block">Price</small>
                                        <span class="text-success fw-bold fs-5">@item.Price.ToString("C")</span>
                                    </div>
                                    <div class="text-end">
                                        <small class="text-muted d-block">Rating</small>
                                        <span class="text-warning">
                                            <i class="bi bi-star-fill me-1"></i>@item.AverageRating.ToString("0.0")
                                            <small class="text-muted">(@item.ReviewCount)</small>
                                        </span>
                                    </div>
                                </div>

                                @* Action buttons - FIXED WITH mt-auto *@
                                <div class="d-grid gap-2 mt-auto">
                                    @if (!isGuest)
                                    {
                                        <div class="btn-group">
                                            <form asp-controller="Catalog"
                                                  asp-action="ToggleFavorite"
                                                  method="post"
                                                  class="d-inline w-100">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                <button type="submit"
                                                        class="btn @(item.IsFavorited ? "btn-danger" : "btn-outline-danger") w-100">
                                                    <i class="bi @(item.IsFavorited ? "bi-heart-fill" : "bi-heart") me-1"></i>
                                                    @(item.IsFavorited ? "Favorited" : "Favorite")
                                                </button>
                                            </form>
                                        </div>
                                        
                                        <div class="btn-group">
                                            <a asp-controller="Review"
                                                   asp-action="Write"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-outline-glass">
                                                <i class="bi bi-star me-1"></i>Review
                                            </a>
                                            <a asp-action="Details"
                                                   asp-route-id="@item.Id"
                                                   asp-route-returnUrl="@Context.Request.Path"
                                                   class="btn btn-outline-glass">
                                                <i class="bi bi-eye me-1"></i>Details
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <a asp-controller="Account"
                                               asp-action="Login"
                                               class="btn btn-outline-glass w-100">
                                            <i class="bi bi-box-arrow-in-right me-1"></i>Sign in to interact
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        @* Pagination *@
        @if (!isGuest && totalPages > 1 && Model.Any())
        {
            <div class="row mt-5">
                <div class="col-12">
                    <nav aria-label="Catalog pagination">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link glass-pagination"
                                       asp-action="CatalogIndex"
                                       asp-route-page="@(currentPage - 1)"
                                       asp-route-pageSize="@pageSize">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @{
                                int startPage = Math.Max(1, currentPage - 2);
                                int endPage = Math.Min(totalPages, currentPage + 2);

                                if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link glass-pagination"
                                           asp-action="CatalogIndex"
                                           asp-route-page="1"
                                           asp-route-pageSize="@pageSize">1</a>
                                    </li>
                                    @if (startPage > 2)
                                    {
                                        <li class="page-item disabled"><span class="page-link glass-pagination">...</span></li>
                                    }
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link glass-pagination"
                                       asp-action="CatalogIndex"
                                       asp-route-page="@i"
                                       asp-route-pageSize="@pageSize">@i</a>
                                </li>
                            }

                            @if (endPage < totalPages)
                            {
                                @if (endPage < totalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link glass-pagination">...</span></li>
                                }
                                <li class="page-item">
                                    <a class="page-link glass-pagination"
                                       asp-action="CatalogIndex"
                                       asp-route-page="@totalPages"
                                       asp-route-pageSize="@pageSize">@totalPages</a>
                                </li>
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link glass-pagination"
                                       asp-action="CatalogIndex"
                                       asp-route-page="@(currentPage + 1)"
                                       asp-route-pageSize="@pageSize">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        }
    </div>
</div>

@functions {
    public async Task<int> GetTotalDesignsCount()
    {
        var service = Context.RequestServices.GetService<ICatalogService>();
        return await service.GetTotalActiveDesignsAsync();
    }
}

@section Scripts {
    @if (!isGuest)
    {
        <script>
            function filterCatalog() {
                const searchTerm = document.getElementById('searchInput').value.toLowerCase();
                const items = document.querySelectorAll('.catalog-item');
                let visibleCount = 0;

                items.forEach(item => {
                    const title = item.querySelector('.glass-title').textContent.toLowerCase();
                               const description = item.querySelectorAll('.glass-text-muted')[0]?.textContent.toLowerCase() ?? '';
            const materials = item.querySelectorAll('.glass-text-muted')[1]?.textContent.toLowerCase() ?? '';

            if (title.includes(searchTerm) || description.includes(searchTerm) || materials.includes(searchTerm)) {
                        item.style.display = '';
                        visibleCount++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                const countElement = document.getElementById('visibleCount');
                if (countElement) {
                    countElement.textContent = visibleCount;
                }

                const resultsText = document.getElementById('resultsCount').querySelector('strong');
                if (resultsText) {
                    resultsText.textContent = visibleCount;
                }

                const grid = document.getElementById('catalogGrid');
                let noResultsMsg = document.getElementById('noResultsMessage');

                if (visibleCount === 0) {
                    if (!noResultsMsg) {
                        noResultsMsg = document.createElement('div');
                        noResultsMsg.id = 'noResultsMessage';
                        noResultsMsg.className = 'col-12 text-center py-5';
                        noResultsMsg.innerHTML = `
                            <i class="bi bi-emoji-frown fs-1 text-muted"></i>
                            <h4 class="mt-3 text-light">No matching designs</h4>
                            <p class="text-muted">Try different search terms</p>
                        `;
                        grid.appendChild(noResultsMsg);
                    }
                } else if (noResultsMsg) {
                    noResultsMsg.remove();
                }
            }

            let searchTimeout;
            const searchInput = document.getElementById('searchInput');

            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(() => {
                        filterCatalog();
                    }, 300);
                });
            }

            setTimeout(() => {
                document.querySelectorAll(".alert").forEach(alert => alert.style.display = "none");
            }, 3000);

            document.addEventListener('DOMContentLoaded', function() {
                const urlParams = new URLSearchParams(window.location.search);
                const searchParam = urlParams.get('searchTerm');
                if (searchParam && searchInput) {
                    searchInput.value = searchParam;
                    filterCatalog();
                }
            });
        </script>
    }
}