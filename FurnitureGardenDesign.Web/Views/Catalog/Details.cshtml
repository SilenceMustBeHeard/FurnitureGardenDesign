@model FurnitureGardenDesign.Web.ViewModels.Catalog.CatalogDesignViewModel

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card glass-card p-4 text-light position-relative">

            @* ---------------- 3D Button ---------------- *@
            <div class="position-absolute top-0 end-0 p-3">
                @if (Model.Model3DStatus == FurnitureGardenDesign.Data.Common.Enums.Model3DStatus.Ready && !string.IsNullOrEmpty(Model.Model3DUrl))
                {
                  @*   if render uploaded and ready, show the button to open the 3D modal *@
                    <button class="btn btn-outline-light"
                            data-bs-toggle="modal"
                            data-bs-target="#model3DModal">
                        View in 3D
                    </button>
                }
                else
                {
                    @* if not - show disabled button with message *@
                    <button class="btn btn-danger" disabled>
                        No Render uploaded yet!
                    </button>
                }
            </div>


      

            <h2 class="glass-title mb-3">@Model.Title</h2>

            <img src="@Model.Image2DUrl" class="img-fluid details-img mb-4" alt="@Model.Title" />

            <p class="glass-text-muted mb-3">@Model.Description</p>

            <div class="mb-2">
                <strong>Category:</strong> @Model.CategoryName
            </div>

            <div class="mb-2">
                <strong>Price:</strong> <span class="text-success">@Model.Price.ToString("C")</span>
            </div>

            <div class="mb-4">
                <strong>Rating:</strong>
                <span class="text-warning">@Model.AverageRating ★</span>
                <span class="glass-text-muted small">(@Model.ReviewCount reviews)</span>
            </div>

            <form asp-controller="Catalog"
                  asp-action="ToggleFavorite"
                  method="post"
                  class="favorite-form">

                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                @if (User.Identity.IsAuthenticated)
                {
                    <button type="submit"
                            class="btn @(Model.IsFavorited ? "btn-danger" : "btn-outline-danger")">
                        @(Model.IsFavorited ? "❤️ Remove from favorites" : "🤍 Add to favorites")
                    </button>

                    <a asp-controller="Review" asp-action="Write" asp-route-id="@Model.Id" class="btn btn-outline-glass">
                        Write Review
                    </a>

                    <a asp-controller="Review" asp-action="Reviews" asp-route-id="@Model.Id" class="btn btn-outline-glass">
                        View Reviews
                    </a>
                }

            </form>

            <a asp-action="Index" class="btn btn-outline-glass mt-3">Back to Catalog</a>
        </div>
    </div>
</div>

@* ---------------- 3D Modal ---------------- *@
@if (Model.Model3DStatus == FurnitureGardenDesign.Data.Common.Enums.Model3DStatus.Ready)
{
    <div class="modal fade" id="model3DModal" tabindex="-1" aria-labelledby="model3DModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content bg-dark text-light">
                <div class="modal-header">
                    <h5 class="modal-title" id="model3DModalLabel">@Model.Title - 3D View</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <model-viewer src="@Model.Model3DUrl"
                                  camera-controls
                                  auto-rotate
                                  style="width:100%; height:600px;">
                    </model-viewer>
                </div>
            </div>
        </div>
    </div>
}

