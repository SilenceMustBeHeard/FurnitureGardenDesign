@model IEnumerable<FurnitureGardenDesign.Web.ViewModels.Catalog.CatalogDesignViewModel>

@{
    ViewData["Title"] = "Catalog";
    bool isLoggedIn = User.Identity?.IsAuthenticated ?? false;
}
<div class="card glass-card p-4 text-light">
    <h2 class="text-center mb-5 text-light fw-bold">
        Catalog
    </h2>
<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-lg-4 col-md-6">
            <div class="card glass-card h-100">

                <img src="@item.ImageUrl"
                     class="card-img-top catalog-img"
                     alt="@item.Title" />

                <div class="card-body d-flex flex-column text-light">

                    <h5 class="glass-title mb-2">
                        @item.Title
                    </h5>

                    <p class="glass-text-muted small mb-3">
                        @item.Description
                    </p>

                    <div class="mb-1">
                        <strong>Price:</strong>
                        <span class="text-success">
                            @item.Price.ToString("F2")
                        </span>
                    </div>

                    <div class="mb-3">
                        <strong>Rating:</strong>
                        <span class="text-warning">
                            @item.AverageRating ★
                        </span>
                        <span class="glass-text-muted small">
                            (@item.ReviewCount)
                        </span>
                    </div>

                 
                </div>
            </div>
        </div>
    }
</div>
</div>