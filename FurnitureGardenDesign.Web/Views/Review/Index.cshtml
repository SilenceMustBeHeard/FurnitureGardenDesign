@model IEnumerable<FurnitureGardenDesign.Web.ViewModels.Catalog.CatalogDesignViewModel>

@{
    ViewData["Title"] = "Write Reviews";
}

<h2 class="text-center mb-5 text-light fw-bold">
    Write a Review
</h2>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-lg-4 col-md-6">
            <div class="card glass-card h-100">

                <img src="@item.ImageUrl"
                     class="card-img-top review-img"
                     alt="@item.Title" />

                <div class="card-body d-flex flex-column text-light">

                    <h5 class="card-title fw-semibold">@item.Title</h5>

                    <p class="card-text small text-muted">
                        @item.Description
                    </p>

                    <div class="mb-2">
                        <span class="fw-semibold">Price:</span>
                        <span class="text-success">
                            @item.Price.ToString("C")
                        </span>
                    </div>

                    <div class="mb-3">
                        <span class="fw-semibold">Rating:</span>
                        <span class="text-warning">
                            @item.AverageRating.ToString("0.0") ★
                        </span>
                        <span class="text-muted small">
                            (@item.ReviewCount reviews)
                        </span>
                    </div>

                    <!-- REVIEW FORM -->
                    <form asp-controller="Review"
                          asp-action="Post"
                          method="post"
                          class="mt-auto glass-form">

                        <input type="hidden" name="catalogDesignId" value="@item.Id" />

                        <div class="mb-2">
                            <label class="form-label small text-muted">
                                Rating
                            </label>
                            <select class="form-select form-select-sm glass-input"
                                    name="rating"
                                    required>
                                @for (int i = 5; i >= 0; i--)
                                {
                                    <option value="@i">@i ★</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-muted">
                                Comment
                            </label>
                            <textarea class="form-control form-control-sm glass-input"
                                  name="comment"
                                  rows="2"
                                  placeholder="Share your thoughts..."></textarea>
                        </div>

                        <button type="submit"
                                class="btn btn-primary-glass w-100 fw-semibold">
                            Submit Review
                        </button>
                    </form>

                </div>
            </div>
        </div>
    }
</div>
