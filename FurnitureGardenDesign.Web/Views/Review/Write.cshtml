@model FurnitureGardenDesign.Web.ViewModels.Catalog.CatalogDesignViewModel

@{
    ViewData["Title"] = "Write Review";
}

<h2 class="text-center mb-5 text-light fw-bold">
    Write a Review
</h2>

<div class="row justify-content-center">
    <div class="col-lg-6">

        <div class="card glass-card h-100">

            <img src="@Model.Image2DUrl" class="card-img-top review-img" alt="@Model.Title" />

            <div class="card-body d-flex flex-column text-light">

                <h5 class="glass-title mb-2">@Model.Title</h5>

                <p class="glass-text-muted small mb-3">@Model.Description</p>

                <div class="mb-2">
                    <strong>Price:</strong>
                    <span class="text-success">@Model.Price.ToString("F2")</span>
                </div>

                <div class="mb-3">
                    <strong>Rating:</strong>
                    <span class="text-warning">@Model.AverageRating.ToString("0.0") ★</span>
                    <span class="glass-text-muted small">(@Model.ReviewCount reviews)</span>
                </div>

                <form asp-controller="Review" asp-action="Post" method="post" class="mt-auto glass-form">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="catalogDesignId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label small glass-text-muted">Rating</label>
                        <select class="form-select form-select-sm glass-input" name="rating" required>
                            @for (int i = 5; i >= 0; i--)
                            {
                                <option value="@i">@i ★</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small glass-text-muted">Comment</label>
                        <textarea class="form-control form-control-sm glass-input" name="comment" rows="3" placeholder="Share your thoughts..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary-glass w-100 fw-semibold">Submit Review</button>
                </form>

                <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-glass mt-3 w-100">
                    Back to Design
                </a>

            </div>
        </div>
    </div>
</div>
