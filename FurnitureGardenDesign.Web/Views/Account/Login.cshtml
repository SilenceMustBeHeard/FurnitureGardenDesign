@model FurnitureGardenDesign.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="full-glass-wrapper">

    @* Frosted glass background layer *@
    <div class="full-glass-bg"></div>

    @* Centered glass login card *@
    <div class="full-glass-content d-flex justify-content-center align-items-center">
        <div class="glass-card p-4 p-md-5 shadow-lg">

            @* Header *@
            <div class="text-center mb-4">
                <h2 class="auth-title">Welcome back</h2>
                <p class="auth-subtitle">Sign in to continue</p>
            </div>

            @* Login Form *@
            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                @* Email *@
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control glass-input" placeholder="Enter your email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                @* Password *@
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control glass-input" placeholder="Enter your password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                @* Remember me check *@
                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Remember Me</label>
                </div>

               @*  Auth button *@
                <button type="submit" class="auth-btn-glass w-100">
                    Log In
                </button>

              @*  Optional *@
                <div class="text-center mb-3">
                    <span class="small text-muted">Don't have an account?</span>
                </div>

               @* Create acc button *@
                <a asp-action="Register"
                   class="btn btn-outline-glass w-100 fw-semibold py-2">
                    Create Account
                </a>

                <div class="text-center mt-3">
                    <a asp-action="ForgotPassword" class="text-decoration-none" style="color: #c09a6c;">
                        Forgot your password?
                    </a>
                </div>

                
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
