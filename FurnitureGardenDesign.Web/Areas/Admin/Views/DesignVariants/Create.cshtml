@model FurnitureGardenDesign.Web.ViewModels.DesignVariants.DesignVariantViewModel

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9 col-12">

            <div class="glass p-4 p-md-5 rounded-4 shadow-lg">

                <h2 class="text-center mb-4 hero-title">Create Design Proposal</h2>

                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="OrderId" />

                    <div class="mb-3">
                        <label asp-for="Image2DUrl" class="form-label"></label>
                        <input asp-for="Image2DUrl" class="form-control glass-input" placeholder="Optional URL for 2D image" />
                        <span asp-validation-for="Image2DUrl" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Model3DUrl" class="form-label"></label>
                        <input asp-for="Model3DUrl" class="form-control glass-input" placeholder="Optional URL for 3D model" />
                        <span asp-validation-for="Model3DUrl" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control glass-input" placeholder="Give additional info to the customer"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <button type="submit" class="btn btn-outline-glass">Review Design Proposal</button>

                        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-primary-glass">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
