@model FurnitureGardenDesign.Web.ViewModels.DesignVariants.DesignVariantViewModel

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9 col-12">

            <div class="glass-card p-4 p-md-5 rounded-4 shadow-lg border-0">

                @* Header with icon *@
                <div class="text-center mb-4">
                    <div class="glass-icon-circle mx-auto mb-3">
                        <i class="bi bi-pencil-square fs-1" style="color: #c09a6c;"></i>
                    </div>
                    <h2 class="fw-bold mb-2 hero-title">Create Design Proposal</h2>
                    <p class="text-muted small">
                        Fill in the details below to create a new design proposal
                    </p>
                </div>

                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="OrderId" />

                    <div class="row g-3">
                        @* Image URL field *@
                        <div class="col-12">
                            <div class="mb-3">
                                <label asp-for="Image2DUrl" class="form-label fw-semibold">
                                    <i class="bi bi-image me-1" style="color: #c09a6c;"></i> 2D Image URL
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text glass-input-prepend">
                                        <i class="bi bi-link-45deg"></i>
                                    </span>
                                    <input asp-for="Image2DUrl" class="form-control glass-input" placeholder="https://example.com/design-image.jpg" />
                                </div>
                                <span asp-validation-for="Image2DUrl" class="text-danger small"></span>
                                <small class="text-muted d-block mt-1">Optional - Provide a link to a 2D preview image</small>
                            </div>
                        </div>

                        @* 3D Model URL field *@
                        <div class="col-12">
                            <div class="mb-3">
                                <label asp-for="Model3DUrl" class="form-label fw-semibold">
                                    <i class="bi bi-cube me-1" style="color: #c09a6c;"></i> 3D Model URL
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text glass-input-prepend">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </span>
                                    <input asp-for="Model3DUrl" class="form-control glass-input" placeholder="https://example.com/model.glb" />
                                </div>
                                <span asp-validation-for="Model3DUrl" class="text-danger small"></span>
                                <small class="text-muted d-block mt-1">Optional - Provide a link to a 3D model (GLB format)</small>
                            </div>
                        </div>

                        @* Notes field *@
                        <div class="col-12">
                            <div class="mb-3">
                                <label asp-for="Notes" class="form-label fw-semibold">
                                    <i class="bi bi-chat-text me-1" style="color: #c09a6c;"></i> Designer Notes
                                </label>
                                <textarea asp-for="Notes" class="form-control glass-input" rows="5"
                                          placeholder="Provide additional information to the customer about this design..."></textarea>
                                <span asp-validation-for="Notes" class="text-danger small"></span>
                                <small class="text-muted d-block mt-1">Optional - Add any notes or instructions for the customer</small>
                            </div>
                        </div>
                    </div>

                    @* Image Preview Section *@
                    <div id="imagePreview" class="mt-3 mb-4 text-center" style="display: none;">
                        <div class="glass-card p-3">
                            <img id="previewImg" class="img-fluid rounded" style="max-height: 200px; max-width: 100%;" />
                            <p class="small text-muted mt-2">Image Preview</p>
                        </div>
                    </div>

                    @* Action Buttons *@
                    <div class="d-flex gap-3 justify-content-between mt-4">
                        <button type="submit" class="btn btn-primary-glass px-4 py-2">
                            <i class="bi bi-send me-2"></i> Review Design Proposal
                        </button>
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-outline-glass px-4 py-2">
                            <i class="bi bi-x-circle me-2"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // Live image preview for 2D image URL
        const urlInput = document.getElementById('Image2DUrl');
        const previewDiv = document.getElementById('imagePreview');
        const previewImg = document.getElementById('previewImg');

        if (urlInput) {
            function showImagePreview() {
                const url = urlInput.value.trim();
                if (url && (url.startsWith('http://') || url.startsWith('https://'))) {
                    previewImg.src = url;
                    previewDiv.style.display = 'block';
                    previewImg.onload = function() {
                        previewDiv.style.display = 'block';
                    };
                    previewImg.onerror = function() {
                        previewDiv.style.display = 'none';
                    };
                } else {
                    previewDiv.style.display = 'none';
                }
            }

            urlInput.addEventListener('input', function() {
                setTimeout(showImagePreview, 300);
            });
        }
    </script>
}
