@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="text-center mb-5 text-light fw-bold">
    Furniture & Garden Design – Admin Panel
</h2>
<p class="text-center lead mb-5 text-light">
    Manage your platform content and users
</p>

<div class="row g-4">

    @* Manage Users *@
    <div class="col-lg-3 col-md-6">
        <div class="card glass-card h-100 text-light">
            <div class="card-body d-flex flex-column align-items-center text-center">
                <h5 class="glass-title mb-2">Users</h5>
                <p class="glass-text-muted small mb-3">Manage users and roles</p>
                <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index"
                   class="btn btn-primary-glass fw-bold w-300 mt-auto">
                    Manage Users
                </a>
            </div>
        </div>
    </div>

    @* Manage Orders *@
    <div class="col-lg-3 col-md-6">
        <div class="card glass-card h-100 text-light">
            <div class="card-body d-flex flex-column align-items-center text-center">
                <h5 class="glass-title mb-2">Orders</h5>
                <p class="glass-text-muted small mb-3">View & process orders</p>
                <a asp-area="Admin" asp-controller="OrderManagement" asp-action="Index"
                   class="btn btn-primary-glass fw-bold w-300 mt-auto">
                    Manage Orders
                </a>
            </div>
        </div>
    </div>

    @* Manage Categories *@
    <div class="col-lg-3 col-md-6">
        <div class="card glass-card h-100 text-light">
            <div class="card-body d-flex flex-column align-items-center text-center">
                <h5 class="glass-title mb-2">Categories</h5>
                <p class="glass-text-muted small mb-3">Furniture & garden types</p>
                <a asp-area="Admin" asp-controller="CategoryManagement" asp-action="Index"
                   class="btn btn-primary-glass fw-bold w-300 mt-auto">
                    Manage Categories
                </a>
            </div>
        </div>
    </div>

    @* Manage Reviews *@
    <div class="col-lg-3 col-md-6">
        <div class="card glass-card h-100 text-light">
            <div class="card-body d-flex flex-column align-items-center text-center">
                <h5 class="glass-title mb-2">Reviews</h5>
                <p class="glass-text-muted small mb-3">Moderate customer reviews</p>
                <a asp-area="Admin" asp-controller="ReviewManagement" asp-action="Index"
                   class="btn btn-primary-glass fw-bold w-300 mt-auto">
                    Manage Reviews
                </a>
            </div>
        </div>
    </div>

</div>
