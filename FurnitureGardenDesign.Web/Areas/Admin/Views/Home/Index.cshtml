

@{
    ViewData["Title"] = "Admin Dashboard";
}


<h2 class="text-center mb-5 text-light fw-bold">
    Furniture & Garden Design – Admin Panel
</h2>


<div class="card glass-card p-4 text-light">
<p class="text-center lead mb-5 text-light">
    Manage your platform content and users
</p>

<div class="row g-4">

    @* Manage Users *@
    <div class="col-lg-3 col-md-6">
        <div class="card glass-card h-100 text-light">
            <div class="card-body d-flex flex-column align-items-center text-center">
                <h5 class="glass-title mb-2">Manage Users</h5>
                <p class="glass-text-muted small mb-3">Manage users and roles</p>
                <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index"
                       class="btn btn-outline-glass fw-bold w-300 mt-auto">
                   Open
                </a>
            </div>
        </div>
    </div>

    @* Manage Orders *@
    <div class="col-lg-3 col-md-6">
        <div class="card glass-card h-100 text-light">
            <div class="card-body d-flex flex-column align-items-center text-center">
                <h5 class="glass-title mb-2">Manage Orders</h5>
                <p class="glass-text-muted small mb-3">View & process orders</p>
                <a asp-area="Admin" asp-controller="OrdersManagement" asp-action="Manage"
                       class="btn btn-outline-glass fw-bold w-300 mt-auto">
                    Open
                </a>
            </div>
        </div>
    </div>

    @* Manage Categories *@
    <div class="col-lg-3 col-md-6">
        <div class="card glass-card h-100 text-light">
            <div class="card-body d-flex flex-column align-items-center text-center">
                <h5 class="glass-title mb-2">Manage Categories</h5>
                <p class="glass-text-muted small mb-3">Furniture & garden types</p>
                <a asp-area="Admin" asp-controller="CategoryManagement" asp-action="EditList"
                   class="btn btn-outline-glass fw-bold w-300 mt-auto">
                    Open
                </a>
            </div>
        </div>
    </div>

        @* Manage Catalog *@
        <div class="col-lg-3 col-md-6">
            <div class="card glass-card h-100 text-light">
                <div class="card-body d-flex flex-column align-items-center text-center">
                    <h5 class="glass-title mb-2">Manage Catalog</h5>
                    <p class="glass-text-muted small mb-3">Manage furniture & garden items</p>
                    <a asp-area="Admin" asp-controller="CatalogManagement" asp-action="EditList"
                       class="btn btn-outline-glass fw-bold w-300 mt-auto">
                        Open
                    </a>
                </div>
            </div>
        </div>

    @* Manage Reviews *@
    <div class="col-lg-3 col-md-6">
        <div class="card glass-card h-100 text-light">
            <div class="card-body d-flex flex-column align-items-center text-center">
                <h5 class="glass-title mb-2">Manage Reviews</h5>
                <p class="glass-text-muted small mb-3">Moderate customer reviews</p>
                <a asp-area="Admin" asp-controller="ReviewManagement" asp-action="EditList"
                       class="btn btn-outline-glass fw-bold w-300 mt-auto">
                 Open
                </a>
            </div>
        </div>
    </div>

</div>
</div>