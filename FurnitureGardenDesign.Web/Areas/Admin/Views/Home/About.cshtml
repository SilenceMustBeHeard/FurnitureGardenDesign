@{
    ViewData["Title"] = "About";
}

<section class="hero-section">
    <div class="hero-glass text-start">

        <h1 class="hero-title mb-4">
            About Furniture & Garden Design
        </h1>

        <p class="hero-subtitle mb-4">
            Furniture & Garden Design is an intelligent design platform that blends creativity
            with AI-powered precision. We help you transform ideas into beautifully crafted
            furniture and outdoor concepts — tailored to your space, your style, and your vision.
        </p>

        <hr class="my-4" />

        <p class="mb-3">
            Whether you’re designing a custom interior piece or planning a complete garden setup,
            our system generates detailed 2D and 3D visualizations based on your dimensions,
            descriptions, and reference images. No design experience required —
            just your imagination.
        </p>

        <p class="mb-3">
            Registered users can create personalized design requests, explore curated catalog
            collections, save favorite concepts, and collaborate on multiple variations
            before choosing the final version.
        </p>

        <p class="mb-0">
            This project is built with scalability and innovation in mind.
            Upcoming updates will introduce more advanced AI design intelligence,
            improved customization tools, and a richer interactive experience.
        </p>

    </div>
</section>
