@model FurnitureGardenDesign.Web.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
<div class="full-glass-wrapper">

    <!-- Frosted background overlay -->
    <div class="full-glass-bg"></div>

    <!-- Centered glass login card -->
    <div class="full-glass-content d-flex justify-content-center align-items-center">
        <div class="glass-card p-4 p-md-5 shadow-lg">


        <h2 class="auth-title">Create account</h2>
        <p class="auth-subtitle">Join Furniture &amp; Garden Design</p>

        <form asp-action="Register" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control glass-input" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control glass-input" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" type="password" class="form-control glass-input" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

           @*  MPORTANT: no .btn here  *@
            <button type="submit" class="auth-btn-glass w-100">
                Create Account
            </button>
        </form>
    </div>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
