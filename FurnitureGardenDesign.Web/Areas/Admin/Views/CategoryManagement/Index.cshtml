@model IEnumerable<FurnitureGardenDesign.Web.ViewModels.Category.CategoryViewModelList>

@{
    ViewData["Title"] = "Categories";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-warning"> Categories</h2>

        <a asp-area="Admin"
           asp-controller="CategoryManagement"
           asp-action="Create"
           class="btn btn-warning-glass fw-semibold">
             Add Category
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="glass-card p-4 text-center text-muted">
            No categories loaded yet.
        </div>
    }
    else
    {
        <div class="glass-card p-4">
            <table class="table table-hover text-light">
                <thead>
                    <tr>
                        <th>Name</th>
                       
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td>@(c.IsActive ? "Yes" : "No")</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@c.Id"
                                   class="btn btn-sm btn-outline-glass">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>
