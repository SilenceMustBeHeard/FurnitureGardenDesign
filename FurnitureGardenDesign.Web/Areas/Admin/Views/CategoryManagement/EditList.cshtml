@model IEnumerable<FurnitureGardenDesign.Web.ViewModels.Category.CategoryViewModelList>

@{
    ViewData["Title"] = "Edit Categories";
}

<div class="row justify-content-center">
    <div class="col-lg-10">

        <div class="card glass-card p-4 text-light">
            <h2 class="glass-title mb-4 text-center">
                Manage Categories
            </h2>

            @if (!Model.Any())
            {
                <p class="text-center glass-text-muted">
                    No categories loaded yet.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-borderless align-middle glass-table text-light">
                        <thead>
                            <tr class="glass-text-muted">
                                <th style="width: 45%">Name</th>
                                <th style="width: 20%">Active</th>
                                <th style="width: 35%" class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr class="glass-row">
                                    <td class="glass-text-muted fw-semibold">
                                        @c.Name
                                    </td>

                                    <td>
                                        <span class="badge @(c.IsActive ? "bg-success-glass" : "bg-danger-glass")">
                                            @(c.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <a asp-area="Admin"
                                           asp-controller="CategoryManagement"
                                           asp-action="Edit"
                                           asp-route-id="@c.Id"
                                           class="btn btn-outline-glass btn-sm me-2">
                                            Edit
                                        </a>

                                        <a asp-area="Admin"
                                           asp-controller="Category"
                                           asp-action="Toggle"
                                           asp-route-id="@c.Id"
                                           class="btn btn-outline-glass btn-sm">
                                            @(c.IsActive ? "Disable" : "Enable")
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                      

                    </table>
                </div>
            }

            <div class="text-center mt-4">
                <a asp-area="Admin"
                   asp-controller="CategoryManagement"
                   asp-action="Create"
                   class="btn btn-outline-glass">
                    Add Category
                </a>



                <a asp-area="Admin"
                   asp-controller="CategoryManagement"
                   asp-action="Index"
                   class="btn btn-outline-glass">
                    ← Back
                </a>
            </div>
        </div>

    </div>
</div>
