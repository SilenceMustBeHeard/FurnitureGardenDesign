@model IEnumerable<FurnitureGardenDesign.Web.ViewModels.Category.CategoryViewModelList>

@{
    ViewData["Title"] = "Edit Categories";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        @*glass wrapper*@
        <div class="card glass-card p-4 text-light shadow-sm">

            <h2 class="glass-title mb-4 text-center">Manage Categories</h2>
            @*if no categories loaded*@ 
            @if (!Model.Any())
            {
                <p class="text-center glass-text-muted fst-italic">No categories loaded yet.</p>
            }
            else
            {
                @*glass table for categories*@ 
                <div class="glass-table">
                    <table class="table table-borderless align-middle glass-table text-light">
                        <thead>
                            @* Table header *@
                            <tr class="glass-text-muted text-uppercase small">
                                <th style="width:45%">Name</th>
                                <th style="width:20%">Status</th>
                                <th style="width:35%" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr class="glass-row @(c.IsDeleted ? "opacity-50" : "hover-glass-row")">
                                    <td class="glass-text-muted fw-semibold">@c.Name</td>
                                    <td>
                                        @*Describes the status of the category*@ 
                                        <span class="badge @(c.IsDeleted ? "bg-success-glass" : "bg-danger-glass")">
                                            @(c.IsDeleted ? "Active" : "Inactive")
                                        </span>
                                    </td>

                                    @*Edit*@
                                    <td class="text-end d-flex justify-content-end flex-wrap gap-2">
                                        <a asp-area="Admin"
                                           asp-controller="CategoryManagement"
                                           asp-action="Edit"
                                           asp-route-id="@c.Id"
                                           class="btn btn-outline-glass btn-sm">
                                            <i class="bi bi-pencil-fill me-1"></i>Edit
                                        </a>

                                        @*Toggle Active Status*@
                                        <form asp-area="Admin"
                                              asp-controller="CategoryManagement"
                                              asp-action="ToggleActive"
                                              asp-route-id="@c.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-glass btn-sm">
                                                <i class="bi bi-toggle-on me-1"></i>Change Status
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="text-center mt-4">
                <a asp-area="Admin"
                   asp-controller="CategoryManagement"
                   asp-action="Create"
                   class="btn btn-outline-glass btn-lg">
                    <i class="bi bi-plus-circle me-1"></i>Add Category
                </a>
            </div>
        </div>
    </div>
</div>

