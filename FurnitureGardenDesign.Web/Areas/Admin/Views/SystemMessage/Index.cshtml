@using FurnitureGardenDesign.Data.Common.Enums
@model IEnumerable<FurnitureGardenDesign.Web.ViewModels.User.SystemInboxMessageViewModel>

@{
    ViewData["Title"] = "System Messages";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card glass-card shadow-lg border-0">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="text-light fw-bold mb-0">
                            <i class="bi bi-envelope-paper me-2"></i>System Messages
                        </h2>
                        <a asp-action="Create" class="btn btn-primary-glass">
                            <i class="bi bi-plus-circle me-2"></i>New Message
                        </a>
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-envelope-open opacity-50 fs-1 text-light"></i>
                            <p class="mt-3 mb-0 opacity-75 text-light">
                                No messages yet
                            </p>
                            <a asp-action="Create" class="btn btn-outline-glass mt-3">
                                <i class="bi bi-plus-circle me-2"></i>Send your first message
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var message in Model)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="card bg-dark border-secondary h-100">
                                        <div class="card-header bg-transparent border-secondary d-flex justify-content-between align-items-center">
                                            <div>
                                                @if (!message.IsRead)
                                                {
                                                    <span class="badge bg-warning text-dark me-2">New</span>
                                                }
                                                @if (message.Type == InboxMessageType.SystemMessage)
                                                {
                                                    <span class="badge bg-info">System</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@message.TypeDisplayName</span>
                                                }
                                            </div>
                                            <small class="text-muted">
                                                @message.CreatedOn.ToLocalTime().ToString("dd MMM yyyy")
                                            </small>
                                        </div>
                                        <div class="card-body">
                                            <p class="card-text text-light">
                                                @(message.Description.Length > 100
                                                    ? message.Description.Substring(0, 100) + "..."
                                                    : message.Description)
                                            </p>
                                        </div>
                                        <div class="card-footer bg-transparent border-secondary">
                                            <a asp-action="Details"
                                                   asp-route-id="@message.Id"
                                                   class="btn btn-sm btn-outline-glass w-100">
                                                <i class="bi bi-eye me-2"></i>Read Message
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>