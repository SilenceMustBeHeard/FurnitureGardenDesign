@using FurnitureGardenDesign.Data.Common.Enums
@model FurnitureGardenDesign.Web.ViewModels.User.SystemInboxMessageViewModel

@{
    ViewData["Title"] = "Message Details";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <div class="glass p-4 p-md-5 rounded-4 shadow-lg">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="hero-title mb-0">Message Details</h2>
                    <a asp-area="Admin"
                           asp-controller="SystemMessage"
                           asp-action="Index"
                           class="btn btn-outline-glass btn-sm">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted">From</label>
                    <p class="text-light fw-bold">@(Model.SenderName ?? "System")</p>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted">Type</label>
                    <p>
                        @if (Model.Type == InboxMessageType.SystemMessage)
                        {
                            <span class="badge bg-info">System Message</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Model.TypeDisplayName</span>
                        }
                    </p>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted">Date</label>
                    <p class="text-light">@Model.CreatedOn.ToLocalTime().ToString("dd MMMM yyyy HH:mm")</p>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted">Message</label>
                    <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.05);">
                        <p class="text-light mb-0" style="white-space: pre-wrap;">@Model.Description</p>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <a asp-area="Admin"
                           asp-controller="SystemMessage"
                           asp-action="Index"
                           class="btn btn-primary-glass">
                        <i class="bi bi-check2-circle me-2"></i>Done
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>