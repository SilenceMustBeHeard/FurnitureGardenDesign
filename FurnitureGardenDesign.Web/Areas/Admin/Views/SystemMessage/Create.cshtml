@using FurnitureGardenDesign.Data.Common.Enums
@model FurnitureGardenDesign.Web.ViewModels.Messages.SystemInboxMessageCreateViewModel

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9 col-12">

            <div class="glass p-4 p-md-5 rounded-4 shadow-lg">

                <h2 class="text-center mb-4 hero-title">Send System Message</h2>

                @if (!string.IsNullOrEmpty(Model.ReceiverName))
                {
                    <div class="alert alert-info mb-4">
                        <i class="bi bi-info-circle me-2"></i>
                        Sending to: <strong>@Model.ReceiverName</strong>
                    </div>
                }
                <form asp-area="Admin"
                      asp-controller="SystemMessage"
                      asp-action="Create"
                      method="post">
                    @Html.AntiForgeryToken()

    
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    
                  

                    <div class="mb-3">
                        <label asp-for="ReceiverId" class="form-label">Recipient</label>
                        @if (Model.AvailableUsers != null && Model.AvailableUsers.Any())
                        {
                            <select asp-for="ReceiverId" class="form-control glass-input" required>
                                <option value="">-- Select a user --</option>
                                @foreach (var user in Model.AvailableUsers)
                                {
                                    <option value="@user.Id" selected="@(user.Id == Model.ReceiverId)">
                                        @user.FullName (@user.Email)
                                    </option>
                                }
                            </select>
                        }
                        else
                        {
                            <input type="text" class="form-control glass-input" value="@Model.ReceiverName" readonly />
                        }
                        <span asp-validation-for="ReceiverId" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Type" class="form-label">Message Type</label>
                        <select asp-for="Type" class="form-control glass-input" asp-items="Html.GetEnumSelectList<InboxMessageType>()">
                            <option value="">-- Select type --</option>
                        </select>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Message</label>
                        <textarea asp-for="Description"
                                  class="form-control glass-input"
                                  rows="5"
                                  placeholder="Type your message here... (minimum 20 characters)"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                        <small class="text-muted mt-1 d-block">Minimum 20 characters</small>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <button type="submit" class="btn btn-outline-glass">
                            <i class="bi bi-send me-2"></i>Send Message
                        </button>

                        <a asp-area="Admin"
                               asp-controller="SystemMessage"
                               asp-action="Index"
                               class="btn btn-primary-glass">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}