@model FurnitureGardenDesign.Web.ViewModels.Messages.InboxMessageViewModel

@{
    ViewData["Title"] = "Message Details";
}

<div class="container py-5">
    <div class="card glass-card p-5 text-light shadow-lg border-0 rounded-4">

        <a asp-controller="Profile"
           asp-action="Index"
           class="btn btn-outline-glass mb-4">
            ← Back to Inbox
        </a>

       
        <div class="row align-items-start g-5">

            @* Left - 2D Image with Proxy handling *@
            <div class="col-lg-8 text-center">
                @if (!string.IsNullOrWhiteSpace(Model.DesignImage2DUrl))
                {
                    bool isDirectImage = Model.DesignImage2DUrl.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase)
                    || Model.DesignImage2DUrl.EndsWith(".png", StringComparison.OrdinalIgnoreCase)
                    || Model.DesignImage2DUrl.EndsWith(".webp", StringComparison.OrdinalIgnoreCase)
                    || Model.DesignImage2DUrl.EndsWith(".gif", StringComparison.OrdinalIgnoreCase)
                    || Model.DesignImage2DUrl.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase);

                    if (isDirectImage)
                    {
                        @* Direct image - use proxy *@
                        <div class="text-center mb-3">
                            <img src="@Url.Action("ProxyImage", "Profile", new { url = Model.DesignImage2DUrl })"
                                 class="img-fluid rounded shadow-lg details-img"
                                 style="max-height:600px; object-fit:contain;"
                                 alt="Design Preview"
                                 onerror="handleImageError(this)" />

                            <div class="mt-2 small text-muted">
                                <a href="@Model.DesignImage2DUrl" target="_blank">Original Image Link</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        @* Handle webpage links *@
                        <div class="webpage-preview mb-3">
                            <div class="webpage-card glass-card p-4 text-center">
                                <i class="bi bi-link-45deg" style="font-size: 6rem; color: #c09a6c;"></i>
                                <h5 class="mt-3">Link Provided</h5>
                                <p class="text-muted fw-bold">The designer shared a page instead of an image.</p>

                                <div class="d-flex gap-2 justify-content-center mt-3">
                                    <a href="@Model.DesignImage2DUrl"
                                       target="_blank"
                                       class="btn btn-primary-glass">
                                        <i class="bi bi-box-arrow-up-right"></i> View Page
                                    </a>

                                    <button type="button"
                                            class="btn btn-outline-glass"
                                            onclick="fetchPagePreview('@Model.DesignImage2DUrl')">
                                        <i class="bi bi-arrow-repeat"></i> Try Fetch Image
                                    </button>
                                </div>

                                <div id="previewContainer" class="mt-4" style="display: none;">
                                    <img id="fetchedImage" class="img-fluid rounded" style="max-height:600px;" />
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted fst-italic">
                        No 2D preview available.
                    </div>
                }
            </div>

            @* Right - Message details and actions *@ 
            <div class="col-lg-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="fw-bold mb-0 display-6">Design Proposal</h2>
                    @if (!Model.IsRead)
                    {
                        <span class="badge bg-warning text-dark">New</span>
                    }
                </div>

                <div class="mb-3">
                    <small class="text-secondary">Order Description</small><br />
                    <p class="glass-text-muted">
                        @(string.IsNullOrEmpty(Model.OrderDescription) ? "No description provided" : Model.OrderDescription)
                    </p>
                </div>

                <div class="mb-3">
                    <small class="text-secondary">Dimensions</small><br />
                    <span class="fw-semibold">
                        @(string.IsNullOrEmpty(Model.OrderDimensions) ? "Not specified" : Model.OrderDimensions)
                    </span>
                </div>

                <div class="mb-3">
                    <small class="text-secondary">Designer Notes</small><br />
                    <p class="glass-text-muted">
                        @(string.IsNullOrEmpty(Model.Notes) ? "No additional notes provided." : Model.Notes)
                    </p>
                </div>

                <div class="mb-4">
                    <small class="text-secondary">Status</small><br />
                    <span class="badge @(Model.IsApproved ? "bg-success" : "bg-warning text-dark") fs-6">
                        @(Model.IsApproved ? "Approved ✓" : "Pending Approval")
                    </span>
                </div>

                <hr class="border-light opacity-25" />

                <div class="mb-3">
                    <small class="text-secondary">Received</small><br />
                    <span class="fw-semibold">
                        <i class="bi bi-calendar3 me-1"></i>
                        @Model.CreatedOn.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                    </span>
                </div>

                @* 3D Model Buttons *@
                <div class="d-grid gap-2 mt-4">
                    @* 3D Model Link *@
                    @if (!string.IsNullOrEmpty(Model.Model3DUrl))
                    {
                        <a href="@Model.Model3DUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-outline-glass w-100">
                            <i class="bi bi-box-arrow-up-right me-2"></i>View 3D Model
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-glass w-100" disabled>
                            <i class="bi bi-cube me-2"></i>3D Not Available
                        </button>
                    }

                  
                    @if (Model.IsApproved)
                    {
                    
                        <div class="alert alert-success text-center mt-2" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            Client has approved this design or requested changes.
                            Check Orders page for more details before continuing.

                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function handleImageError(img) {
            console.log('Image failed to load:', img.src);
            img.style.display = 'none';

            const parent = img.parentElement;
            const fallbackDiv = document.createElement('div');
            fallbackDiv.className = 'webpage-card glass-card p-4';
            fallbackDiv.innerHTML = `
                <i class="bi bi-exclamation-triangle" style="font-size: 3rem; color: #ffc107;"></i>
                <p class="mt-3">Image could not be loaded</p>
                <a href="@Model.DesignImage2DUrl" target="_blank" class="btn btn-outline-glass">
                    View Original Link
                </a>
            `;
            parent.appendChild(fallbackDiv);
        }

        async function fetchPagePreview(url) {
            const container = document.getElementById('previewContainer');
            const img = document.getElementById('fetchedImage');

            container.style.display = 'block';
            img.src = '';

            // show loading spinner
            const spinner = document.createElement('div');
            spinner.className = 'spinner-border text-warning';
            spinner.id = 'loadingSpinner';
            container.insertBefore(spinner, img);

            try {
                const proxyUrl = `https://api.microlink.io/?url=${encodeURIComponent(url)}&screenshot=true&meta=false`;
                const response = await fetch(proxyUrl);
                const data = await response.json();

                document.getElementById('loadingSpinner')?.remove();

                if (data.data?.image?.url) {
                    img.src = data.data.image.url;
                } else if (data.data?.screenshot?.url) {
                    img.src = data.data.screenshot.url;
                } else {
                    throw new Error('No image found');
                }
            } catch (error) {
                document.getElementById('loadingSpinner')?.remove();
                container.innerHTML = `
                    <div class="alert alert-warning">
                        Could not fetch page preview.
                        <a href="${url}" target="_blank">Visit page directly</a>
                    </div>
                `;
            }
        }

        // Auto-hide temp data messages
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert:not(.alert-permanent)');
            alerts.forEach(alert => {
                alert.style.transition = 'opacity 0.5s';
                alert.style.opacity = '0';
                setTimeout(() => alert.remove(), 500);
            });
        }, 3500);
    </script>
}