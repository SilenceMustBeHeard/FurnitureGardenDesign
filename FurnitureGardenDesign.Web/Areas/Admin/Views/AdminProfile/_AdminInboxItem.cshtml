@using FurnitureGardenDesign.Data.Common.Enums
@using FurnitureGardenDesign.Web.ViewModels.Messages
@model InboxMessageViewModel

<a asp-area="Admin"
       asp-controller="AdminProfile"
       asp-action="MessageDetails"
       asp-route-id="@Model.Id"
       class="text-decoration-none">

    <div class="glass-list-item p-3 mb-3 message-card @(Model.IsRead ? "read" : "unread")">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="d-flex align-items-center gap-2">
                <div class="status-dot @(Model.IsRead ? "bg-secondary" : "bg-warning")"></div>
                <small class="text-muted">
                    @Model.CreatedOn.ToLocalTime().ToString("dd MMM yyyy · HH:mm")
                </small>
                @if (Model.Type == InboxMessageType.DesignApproved)
                {
                    <span class="badge bg-success ms-2">✓ Approved</span>
                }
                else if (Model.Type == InboxMessageType.DesignSent)
                {
                    <span class="badge bg-info ms-2">New Design</span>
                }
            </div>
            @if (!Model.IsRead)
            {
                <span class="unread-badge">New</span>
            }
        </div>

        <p class="text-light mb-2">
            @(Model.Notes?.Length > 100 ? Model.Notes?.Substring(0, 100) + "..." : Model.Notes ?? "No notes")
        </p>

        <div class="d-flex gap-2" onclick="event.stopPropagation()">
            <a asp-area="Admin"
                   asp-controller="AdminProfile"
                   asp-action="MessageDetails"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary-glass btn-sm w-100">
                <i class="bi bi-eye me-1"></i>View Details
            </a>
        </div>
    </div>
</a>