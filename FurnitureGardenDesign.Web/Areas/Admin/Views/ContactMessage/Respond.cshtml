@using FurnitureGardenDesign.Web.ViewModels.User;
@model ContactMessageResponseViewModel

@{
    ViewData["Title"] = "Respond to Contact Message";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card glass-card p-5 text-light shadow-lg border-0 rounded-4">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="fw-bold mb-0">Respond to Customer</h2>
                    <a asp-area="Admin"
                           asp-controller="ContactMessage"
                           asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-glass btn-sm">
                        ← Back
                    </a>
                </div>

              @*  Original Message  *@
                <div class="card bg-dark border-secondary mb-4">
                    <div class="card-header bg-transparent border-secondary">
                        <h6 class="text-light mb-0">Original Message</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <strong>From:</strong> @Model.SenderName
                        </div>
                        <div class="mb-2">
                            <strong>Email:</strong> @Model.SenderEmail
                        </div>
                        <div class="mb-2">
                            <strong>Subject:</strong> @Model.Subject
                        </div>
                        <hr class="border-secondary" />
                        <div class="mt-2 p-3 rounded" style="background: rgba(255,255,255,0.05);">
                            @Model.OriginalMessage
                        </div>
                    </div>
                </div>

                @* Response Form *@
                <form 
                    asp-area="Admin"
                      asp-controller="ContactMessage"
                      asp-action="Respond"
                      method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Subject" />
                    <input type="hidden" asp-for="SenderName" />
                    <input type="hidden" asp-for="SenderEmail" />
                    <input type="hidden" asp-for="OriginalMessage" />

                    <div class="mb-3">
                        <label asp-for="Response" class="form-label fw-bold">Your Response</label>
                        <textarea asp-for="Response"
                                  class="form-control glass-input"
                                  rows="8"
                                  placeholder="Type your response here..."></textarea>
                        <span asp-validation-for="Response" class="text-danger"></span>
                        <small class="text-muted mt-1 d-block">
                            <i class="bi bi-info-circle me-1"></i>Your response will be sent to the customer's email address.
                        </small>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-area="Admin"
                               asp-controller="ContactMessage"
                               asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-glass">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary-glass">
                            <i class="bi bi-send me-2"></i>Send Response
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}