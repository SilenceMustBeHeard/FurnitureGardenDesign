@using FurnitureGardenDesign.Web.ViewModels.User;
@model ContactMessageDetailsViewModel

@{
    ViewData["Title"] = "Contact Message Details";
}

<div class="container py-5">
    <div class="card glass-card p-5 text-light shadow-lg border-0 rounded-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0">Contact Message</h2>
            <a asp-area="Admin"
                   asp-controller="AdminProfile"
                   asp-action="AdminInbox"
                   class="btn btn-outline-glass">
                ← Back to Inbox
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row">
            <div class="col-12">
              @* Header *@
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="fw-bold">@Model.Subject</h3>
                        <div class="d-flex align-items-center gap-2 mt-2">
                            @if (!Model.IsRead)
                            {
                                <span class="badge bg-warning text-dark">New</span>
                            }
                            <span class="badge bg-info">Contact Message</span>
                        </div>
                    </div>
                    <small class="text-muted">
                        <i class="bi bi-clock me-1"></i>
                        @Model.CreatedOn.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                    </small>
                </div>

                <hr class="border-light opacity-25" />

             @*  Sender Info *@
                <div class="mb-4">
                    <h6 class="text-warning mb-3">Sender Information</h6>
                    <div class="glass-card p-3">
                        <p class="mb-1"><strong>Name:</strong> @Model.SenderName</p>
                        <p class="mb-1"><strong>Email:</strong> <a href="mailto:@Model.SenderEmail" class="text-warning">@Model.SenderEmail</a></p>
                     
                    </div>
                </div>

             @* Message Content *@
                <div class="mb-4">
                    <h6 class="text-warning mb-3">Message</h6>
                    <div class="glass-card p-3">
                        <p class="text-light mb-0" style="white-space: pre-wrap;">@Model.Message</p>
                    </div>
                </div>

             @*   Response Section *@
                @if (!string.IsNullOrEmpty(Model.Response))
                {
                    <div class="mb-4">
                        <h6 class="text-success mb-3">Your Response</h6>
                        <div class="glass-card p-3" style="border-left: 3px solid #28a745;">
                            <p class="text-light mb-2" style="white-space: pre-wrap;">@Model.Response</p>
                            <small class="text-muted">
                                <i class="bi bi-reply-all me-1"></i>Responded on @Model.RespondedOnFormatted
                            </small>
                        </div>
                    </div>
                }

                <hr class="border-light opacity-25" />

               @* Action Buttons *@
                <div class="d-flex gap-2 justify-content-end mt-4">
                    @if (string.IsNullOrEmpty(Model.Response))
                    {
                        <a asp-area="Admin"
                               asp-controller="ContactMessage"
                               asp-action="Respond"
                               asp-route-id="@Model.Id"
                               class="btn btn-primary-glass">
                            <i class="bi bi-reply me-2"></i>Respond to Message
                        </a>
                    }
                    else
                    {
                        <a asp-area="Admin"
                               asp-controller="ContactMessage"
                               asp-action="Respond"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-glass">
                            <i class="bi bi-pencil me-2"></i>Edit Response
                        </a>
                    }
                    <a asp-area="Admin"
                           asp-controller="AdminProfile"
                           asp-action="AdminInbox"
                           class="btn btn-outline-glass">
                        <i class="bi bi-check2-circle me-2"></i>Done
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>