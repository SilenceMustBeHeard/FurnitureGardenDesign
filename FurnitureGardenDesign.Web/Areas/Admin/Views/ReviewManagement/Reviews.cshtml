@model FurnitureGardenDesign.Web.ViewModels.Review.ReviewListViewModel

@{
    ViewData["Title"] = "Reviews";
}

<div class="row justify-content-center">
    <div class="col-lg-10">

        <div class="card glass-card p-4 text-light">
            <h2 class="glass-title mb-4 text-center">
                Customer Reviews
            </h2>

            @if (!Model.Reviews.Any())
            {
                <p class="text-center glass-text-muted">
                    No reviews yet. Be the first to leave one ⭐
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-borderless align-middle glass-table text-light">
                        <thead>
                            <tr class="glass-text-muted">
                                <th style="width: 15%">Rating</th>
                                <th style="width: 25%">Design</th>
                                <th style="width: 40%">Comment</th>
                                <th style="width: 20%" class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @for (int i = 0; i < Model.Reviews.Count; i++)
                            {
                                var review = Model.Reviews[i];
                                var collapseId = $"review-{i}";

                                <tr class="glass-row">
                                    <td>
                                        <span class="text-warning fw-bold">
                                            @for (int s = 0; s < review.Rating; s++)
                                            {
                                                @:★
                                            }
                                            @for (int s = review.Rating; s < 5; s++)
                                            {
                                                @:☆
                                            }
                                    </span>
                                </td>

                                <td class="glass-text-muted fw-semibold">
                                    @review.CatalogDesignTitle
                                </td>

                                <td class="glass-text-muted small">
                                    @(string.IsNullOrWhiteSpace(review.Comment)
                                                                    ? "No comment provided."
                                                                    : review.Comment.Length > 40
                                                                    ? review.Comment.Substring(0, 40) + "..."
                                                                    : review.Comment)
                                    </td>

                                    <td class="text-end">
                                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                                        {
                                            <button class="btn btn-outline-glass btn-sm"
                                                    type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#@collapseId"
                                                    aria-expanded="false">
                                                Read
                                            </button>
                                        }
                                    </td>
                                </tr>

                                <tr class="collapse glass-collapse-row" id="@collapseId">
                                    <td colspan="4">
                                        <div class="glass-card p-3 mt-2">
                                            <strong class="text-warning">
                                                Full Review
                                            </strong>
                                            <p class="mt-2 mb-0">
                                                @review.Comment
                                            </p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="text-center mt-4">
                <a asp-area="Admin" asp-controller="CatalogManagement"
                   asp-action="AdminIndex"
                   class="btn btn-outline-glass">
                    Back to Catalog
                </a>
            </div>
        </div>

    </div>
</div>
