@model IEnumerable<FurnitureGardenDesign.Web.ViewModels.Catalog.CatalogViewModelList>

@{
    ViewData["Title"] = "Manage Catalog";
}

<div class="row justify-content-center">
    <div class="col-lg-12">
        @*glass wrapper*@
        <div class="card glass-card p-4 text-light shadow-sm">

            <h2 class="glass-title mb-4 text-center">Manage Catalog Items</h2>

            @*if no catalog items loaded*@ 
            @if (!Model.Any())
            {
                <p class="text-center glass-text-muted fst-italic">No catalog items loaded yet.</p>
            }
            else
            {
                @*glass table for catalog*@ 
                    <div class="glass-table">
                    <table class="table table-borderless align-middle glass-table text-light">
                        <thead>
                            @* Table header *@
                            <tr class="glass-text-muted text-uppercase small">
                                <th style="width:5%">#</th>
                                <th style="width:30%">Title</th>
                                <th style="width:15%">Category</th>
                                <th style="width:10%">Price</th>
                                <th style="width:10%">3D Status</th>
                                <th style="width:10%">Status</th>
                                <th style="width:20%" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr class="glass-row @(item.IsDeleted ? "opacity-50" : "hover-glass-row")">
                                    <td class="glass-text-muted">@rowNumber</td>
                                    <td class="glass-text-muted fw-semibold">@item.Title</td>
                                    <td>@item.CategoryName</td>
                                    <td>@item.Price.ToString("C")</td>
                                    <td>
                                        @if (item.Model3DStatus == FurnitureGardenDesign.Data.Common.Enums.Model3DStatus.Ready)
                                        {
                                            <span class="badge bg-success">Ready</span>
                                        }
                                        else if (item.Model3DStatus == FurnitureGardenDesign.Data.Common.Enums.Model3DStatus.Generating)
                                        {
                                            <span class="badge bg-warning text-dark">Generating</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">None</span>
                                        }
                                    </td>
                                    <td>
                                        @* Describes the status of the catalog item *@
                                        <span class="badge @(item.IsDeleted ? "bg-secondary" : "bg-success")">
                                            @(item.IsDeleted ? "INACTIVE" : "ACTIVE")
                                        </span>
                                    </td>

                                    @*Actions*@
                                    <td class="text-end d-flex justify-content-end flex-wrap gap-2">
                                        <a asp-area="Admin"
                                           asp-controller="CatalogManagement"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-glass btn-sm">
                                            <i class="bi bi-pencil-fill me-1"></i>Edit
                                        </a>

                                        @*Toggle Active Status*@
                                        <form asp-area="Admin"
                                              asp-controller="CatalogManagement"
                                              asp-action="ToggleActive"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-glass btn-sm">
                                                <i class="bi bi-toggle-on me-1"></i>
                                                @(item.IsDeleted ? "Activate" : "Deactivate")
                                            </button>
                                        </form>

                                        @*Preview link*@
                                        <a asp-area="Admin"
                                           asp-controller="CatalogManagement"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           target="_blank"
                                           class="btn btn-outline-glass btn-sm">
                                            <i class="bi bi-eye me-1"></i>Preview
                                        </a>
                                    </td>
                                </tr>
                                rowNumber++;
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="text-center mt-4">
                <a asp-area="Admin"
                   asp-controller="CatalogManagement"
                   asp-action="Create"
                   class="btn btn-outline-glass btn-lg">
                    <i class="bi bi-plus-circle me-1"></i>Add Catalog Item
                </a>
            </div>
        </div>
    </div>
</div>