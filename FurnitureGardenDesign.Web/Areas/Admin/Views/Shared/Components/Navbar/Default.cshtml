@using FurnitureGardenDesign.Web.ViewModels
@model NavbarButtonsViewModel

<div class="d-flex align-items-center gap-2">

    @* Role-based buttons *@

    @if (Model.IsAdmin)
    {
       @* Admin *@

        <a class="btn btn-outline-glass btn-sm"
           asp-area="Admin"
           asp-controller="Home"
           asp-action="Index">
            Admin Panel
        </a>

      
        <a class="btn btn-outline-glass"
           asp-controller="OrdersManagement"
           asp-action="Manage">
            Orders (@Model.PendingOrdersCount)
        </a> 

        <a class="btn btn-primary-glass"
           asp-controller="Catalog"
           asp-action="Index">
            Catalogue
        </a>
    }
    else if (Model.IsManager)
    {
      @*   Manager *@
        <a class="btn btn-primary-glass"
           asp-controller="Catalog"
           asp-action="Index">
            Catalogue
        </a>

        <a class="btn btn-outline-glass"
           asp-controller="Orders"
           asp-action="Manage">
            Orders (@Model.PendingOrdersCount)
        </a>
    }
    else if (Model.IsUser)
    {
        
     @* Registered User *@  
        <a class="btn btn-primary-glass"
           asp-controller="Catalog"
           asp-action="Index">
            Catalogue
        </a>

        <a class="btn btn-outline-glass"
           asp-controller="Orders"
           asp-action="Create">
            New Order
        </a>
    }
    else
    {
          @* Guest *@
     @*   <a class="btn btn-primary-glass"
           asp-controller="Catalog"
           asp-action="Explore">
            Catalogue
        </a>   *@
    }
</div>
