@model FurnitureGardenDesign.Web.ViewModels.Orders.DetailsOrderViewModel

@{
    ViewData["Title"] = "Order Details";
}
<div class="card glass-card p-4 text-light">
    <h2 class="glass-title mb-4 text-center"> </h2>
<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4 glass">
        <div class="card-header bg-dark text-white rounded-top-4">
            <h4 class="mb-0">
                <i class="bi bi-clipboard-data"></i> Order Details
            </h4>
        </div>

        <div class="card-body p-4">

            <dl class="row">
                <dt class="col-sm-4 text-muted">User ID</dt>
                <dd class="col-sm-8">@Model.UserId</dd>

                <dt class="col-sm-4 text-muted">Category ID</dt>
                <dd class="col-sm-8">@Model.CategoryId</dd>

                <dt class="col-sm-4 text-muted">Furniture Type</dt>
                <dd class="col-sm-8">@Model.FurnitureType</dd>

                <dt class="col-sm-4 text-muted">Dimensions</dt>
                <dd class="col-sm-8">@Model.Dimensions</dd>

                <dt class="col-sm-4 text-muted">Description</dt>
                <dd class="col-sm-8">@Model.Description</dd>

                <dt class="col-sm-4 text-muted">Status</dt>
                <dd class="col-sm-8">
                    <span class="badge bg-info text-dark">@Model.Status</span>
                </dd>

                @if (!string.IsNullOrWhiteSpace(Model.ReferenceImageUrl))
                {
                    <dt class="col-sm-4 text-muted">Reference Image</dt>
                    <dd class="col-sm-8">
                        <img src="@Model.ReferenceImageUrl"
                             class="img-fluid rounded shadow-sm"
                             style="max-height: 300px;" />
                    </dd>
                }
            </dl>

            <hr class="my-4" />

            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex gap-2">
                 

                    <form asp-area="Admin"
                          asp-controller="OrdersManagement"
                          asp-action="Reject"
                          asp-route-id="@Model.Id"
                          method="post">
                        <button class="btn btn-danger">
                            <i class="bi bi-x-circle"></i> Reject
                        </button>
                    </form>
                </div>

                @*To do : Implement Design Proposal *@

                <a asp-area=""
                   asp-controller="Error"
                   asp-action="NotImplemented"
                   asp-route-orderId="@Model.Id"
                   class="btn btn-primary">
                    <i class="bi bi-brush"></i> Send Design Proposal
                </a>
            </div>

        </div>
    </div>

    <div class="mt-4">
        <a asp-area="Admin"
           asp-controller="OrdersManagement"
           asp-action="Manage"
           class="btn btn-outline-glass">
            <i class="bi bi-arrow-left"></i> Back to Orders
        </a>
    </div>
</div>
</div>