@using FurnitureGardenDesign.Data.Common.Enums
@using FurnitureGardenDesign.Web.ViewModels.User
@model List<InboxMessageViewModel>

@{
    ViewData["Title"] = "Manager Inbox";
}

<div class="container py-5">
    <div class="card glass-card p-5 text-light shadow-lg border-0 rounded-4">
        <h2 class="fw-bold mb-4"> Inbox</h2>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox fs-1 opacity-50"></i>
                <p class="mt-3">No messages in your inbox.</p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var message in Model)
                {
                    <div class="glass-list-item p-3 message-card @(message.IsRead ? "" : "unread")">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    @if (message.Type == InboxMessageType.DesignApproved)
                                    {
                                        <span class="badge bg-success">Approval</span>
                                    }
                                    else if (message.Type == InboxMessageType.DesignSent)
                                    {
                                        <span class="badge bg-info">New Design</span>
                                    }
                                    <small class="text-muted">
                                        @message.CreatedOn.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                    </small>
                                </div>

                                <p class="mb-2">@message.Notes</p>

                                <div class="d-flex gap-2">
                                    <a asp-action="MessageDetails"
                                       asp-route-id="@message.Id"
                                       class="btn btn-primary-glass btn-sm">
                                        View Details
                                    </a>
                                </div>
                            </div>

                            @if (!message.IsRead)
                            {
                                <span class="badge bg-warning text-dark">New</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>