@using FurnitureGardenDesign.Data.Common.Enums
@model FurnitureGardenDesign.Web.ViewModels.User.SystemInboxMessageViewModel

<a asp-area="Manager"
       asp-controller="ManagerProfile"
       asp-action="SystemMessageDetails"
       asp-route-id="@Model.Id"
       class="text-decoration-none">

    <div class="glass-list-item p-3 mb-3 message-card @(Model.IsRead ? "read" : "unread")">

        @* Date and status on top *@
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="d-flex align-items-center gap-2">
                <div class="status-dot @(Model.IsRead ? "bg-secondary" : "bg-warning")"></div>
                <small class="text-muted">
                    @Model.CreatedOn.ToLocalTime().ToString("dd MMM yyyy · HH:mm")
                </small>

                @* Message Type Badge *@
                @if (Model.Type == InboxMessageType.SystemMessage)
                {
                    <span class="badge bg-info ms-2">System</span>
                }
                else if (Model.Type == InboxMessageType.DesignSent)
                {
                    <span class="badge bg-primary ms-2">Design Sent</span>
                }
                else if (Model.Type == InboxMessageType.DesignApproved)
                {
                    <span class="badge bg-success ms-2">Approved</span>
                }
                else if (Model.Type == InboxMessageType.DesignRejected)
                {
                    <span class="badge bg-danger ms-2">Rejected</span>
                }
                else if (Model.Type == InboxMessageType.ChangesRequested)
                {
                    <span class="badge bg-warning text-dark ms-2">Changes Requested</span>
                }
                else
                {
                    <span class="badge bg-secondary ms-2">@Model.TypeDisplayName</span>
                }
            </div>

            @if (!Model.IsRead)
            {
                <span class="unread-badge">New</span>
            }
        </div>

        @* Message Preview *@
        <p class="text-light mb-3 message-preview">
            @(Model.Description.Length > 100 ? Model.Description.Substring(0, 100) + "..." : Model.Description)
        </p>

        @* Sender info if available *@
        @if (!string.IsNullOrEmpty(Model.SenderName))
        {
            <div class="small text-muted mb-2">
                <i class="bi bi-person me-1"></i>From: @Model.SenderName
            </div>
        }

        @* Read Message button *@
        <div class="d-flex gap-2" onclick="event.stopPropagation()">
            <a asp-area="Manager"
                   asp-controller="ManagerProfile"
                   asp-action="SystemMessageDetails"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary-glass btn-sm w-100">
                <i class="bi bi-envelope-open me-1"></i>Read Message
            </a>
        </div>
    </div>
</a>