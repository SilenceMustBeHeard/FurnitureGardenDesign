@using FurnitureGardenDesign.Web.ViewModels.User
@model ContactMessageDetailsViewModel

<a asp-area="Manager"
       asp-controller="ContactMessage"
       asp-action="Details"
       asp-route-id="@Model.Id"
       class="text-decoration-none">

    <div class="glass-list-item p-3 mb-3 message-card @(Model.IsReadByAdmin ? "read" : "unread")">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="d-flex align-items-center gap-2">
                <div class="status-dot @(Model.IsReadByAdmin ? "bg-secondary" : "bg-warning")"></div>
                <small class="text-muted">
                    @Model.CreatedOn.ToLocalTime().ToString("dd MMM yyyy · HH:mm")
                </small>
                <span class="badge bg-info ms-2">📧 Contact</span>
            </div>
            @if (!Model.IsReadByAdmin)
            {
                <span class="unread-badge">New</span>
            }
        </div>

        <div class="mb-2">
            <strong class="text-light">@Model.Subject</strong>
        </div>

        <p class="text-light mb-2 message-preview">
            @(Model.Message.Length > 100 ? Model.Message.Substring(0, 100) + "..." : Model.Message)
        </p>

        <div class="small text-muted mb-2">
            <i class="bi bi-person me-1"></i>From: @Model.SenderName (@Model.SenderEmail)
        </div>

        @if (!string.IsNullOrEmpty(Model.Response))
        {
            <div class="small text-success mb-2">
                <i class="bi bi-check-circle me-1"></i>Responded on @Model.RespondedOnFormatted
            </div>
        }

        <div class="d-flex gap-2" onclick="event.stopPropagation()">
            <a asp-area="Manager"
                   asp-controller="ContactMessage"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary-glass btn-sm w-100">
                <i class="bi bi-envelope-open me-1"></i>View & Respond
            </a>
        </div>
    </div>
</a>