@using FurnitureGardenDesign.Web.ViewModels.User
@model ProfileViewModel

@{
    ViewData["Title"] = "Manager Profile";
}

<div class="container py-5">
    @*Header*@
    <div class="mb-4 text-light">
        <h2 class="fw-bold mb-1">My Profile</h2>
        <p class="opacity-75 mb-0">
            Manage your personal information and messages
        </p>
    </div>

    @*Main card*@
    <div class="card glass-card shadow-lg p-4 p-md-5">
        <div class="row g-4">

            @* User Info *@
            <div class="col-xl-4 col-lg-5">
                <div class="h-100 text-light">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-person-circle fs-2 me-2"></i>
                        <h5 class="fw-bold mb-0">Profile Info</h5>
                    </div>

                    <hr />

                    <p class="mb-3">
                        <strong>Full Name:</strong><br />
                        <span class="opacity-75">
                            @Model.FirstName @Model.LastName
                        </span>
                    </p>

                    <p class="mb-3">
                        <strong>Email:</strong><br />
                        <span class="opacity-75">
                            @Model.Email
                        </span>
                    </p>

                    <p class="mb-0">
                        <strong>Address:</strong><br />
                        <span class="opacity-75">
                            @Model.Address
                        </span>
                    </p>
                </div>
            </div>

            @* Divider *@
            <div class="col-lg-1 d-none d-lg-flex justify-content-center">
                <div class="vr text-light opacity-25"></div>
            </div>

            @* Inbox with Tabs *@
            <div class="col-xl-7 col-lg-6">
                <div class="h-100 text-light">

                    @* Tab navigation *@
                    <ul class="nav nav-tabs mb-3 border-bottom-0" id="inboxTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active bg-transparent text-light border-0 border-bottom border-2"
                                    id="design-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#design"
                                    type="button"
                                    role="tab"
                                    style="border-bottom-color: #c09a6c !important;">
                                <i class="bi bi-pencil-square me-2"></i>Design Messages
                                @{
                                    var unreadDesignCount = Model.Inbox?.Count(x => !x.IsRead) ?? 0;
                                }
                                @if (unreadDesignCount > 0)
                                {
                                    <span class="badge bg-warning text-dark ms-2">@unreadDesignCount</span>
                                }
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link bg-transparent text-light border-0 border-bottom border-2"
                                    id="system-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#system"
                                    type="button"
                                    role="tab">
                                <i class="bi bi-megaphone me-2"></i>System Messages
                                @{
                                    var unreadSystemCount = Model.SystemInbox?.Count(x => !x.IsRead) ?? 0;
                                }
                                @if (unreadSystemCount > 0)
                                {
                                    <span class="badge bg-warning text-dark ms-2">@unreadSystemCount</span>
                                }
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link bg-transparent text-light border-0 border-bottom border-2"
                                    id="contact-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#contact"
                                    type="button"
                                    role="tab">
                                <i class="bi bi-chat-dots me-2"></i>Contact Messages
                                @{
                                    
                                    var unreadContactCount = Model.ContactMessages?.Count(x => !x.IsReadByAdmin) ?? 0;
                                }
                                @if (unreadContactCount > 0)
                                {
                                    <span class="badge bg-warning text-dark ms-2">@unreadContactCount</span>
                                }
                            </button>
                        </li>
                    </ul>

                    @* Tab content *@
                    <div class="tab-content" id="inboxTabsContent">

                        @* Design Messages *@
                        <div class="tab-pane fade show active" id="design" role="tabpanel">
                            @if (Model.Inbox == null || !Model.Inbox.Any())
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-envelope-open opacity-50 fs-1"></i>
                                    <p class="mt-3 mb-0 opacity-75">
                                        No design messages
                                    </p>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-3" style="max-height: 500px; overflow-y: auto; padding-right: 10px;">
                                    @foreach (var message in Model.Inbox)
                                    {
                                        @await Html.PartialAsync("_InboxItem", message)
                                    }
                                </div>
                            }
                        </div>

                      @*   System Messages Tab *@
                        <div class="tab-pane fade" id="system" role="tabpanel">
                            @if (Model.SystemInbox == null || !Model.SystemInbox.Any())
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-megaphone opacity-50 fs-1"></i>
                                    <p class="mt-3 mb-0 opacity-75">
                                        No system messages
                                    </p>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-3" style="max-height: 500px; overflow-y: auto; padding-right: 10px;">
                                    @foreach (var message in Model.SystemInbox)
                                    {
                                        @await Html.PartialAsync("_SystemInboxItem", message)
                                    }
                                </div>
                            }
                        </div>

                      @* Contact Messages *@
                        <div class="tab-pane fade" id="contact" role="tabpanel">
                            @if (Model.ContactMessages == null || !Model.ContactMessages.Any())
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-chat-dots opacity-50 fs-1"></i>
                                    <p class="mt-3 mb-0 opacity-75">No contact messages</p>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-3" style="max-height: 500px; overflow-y: auto; padding-right: 10px;">
                                    @foreach (var message in Model.ContactMessages)
                                    {
                                        <a asp-area="Manager"
                                               asp-controller="ContactMessage"
                                               asp-action="Details"
                                               asp-route-id="@message.Id"
                                               class="text-decoration-none">
                                            <div class="glass-list-item p-3 message-card @(message.IsReadByAdmin ? "read" : "unread")">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div class="flex-grow-1">
                                                        <div class="d-flex align-items-center gap-2 mb-2">
                                                            <span class="badge bg-info">Contact</span>
                                                            <small class="text-muted">
                                                                @message.CreatedOn.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                                            </small>
                                                        </div>
                                                        <div class="mb-2">
                                                            <strong>@message.Subject</strong>
                                                        </div>
                                                        <p class="mb-2">@(message.Message.Length > 100 ? message.Message.Substring(0, 100) + "..." : message.Message)</p>
                                                        <div class="small text-muted mb-2">
                                                            <i class="bi bi-person me-1"></i>From: @message.SenderName
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(message.Response))
                                                        {
                                                            <div class="small text-success">
                                                                <i class="bi bi-check-circle me-1"></i>Responded
                                                            </div>
                                                        }
                                                        <div class="d-flex gap-2 mt-2">
                                                            <span class="btn btn-primary-glass btn-sm">View & Respond</span>
                                                        </div>
                                                    </div>
                                                    @if (!message.IsReadByAdmin)
                                                    {
                                                        <span class="badge bg-warning text-dark">New</span>
                                                    }
                                                </div>
                                            </div>
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


