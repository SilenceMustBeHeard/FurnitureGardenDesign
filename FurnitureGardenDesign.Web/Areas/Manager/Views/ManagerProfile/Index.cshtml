@using FurnitureGardenDesign.Web.ViewModels.User
@model ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">
    @*Header*@
    <div class="mb-4 text-light">
        <h2 class="fw-bold mb-1">My Profile</h2>
        <p class="opacity-75 mb-0">
            Manage your personal information and messages
        </p>
    </div>

    @*Main card*@
    <div class="card glass-card shadow-lg p-4 p-md-5">
        <div class="row g-4">

            @* User Info *@
            <div class="col-xl-4 col-lg-5">
                <div class="h-100 text-light">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-person-circle fs-2 me-2"></i>
                        <h5 class="fw-bold mb-0">Profile Info</h5>
                    </div>

                    <hr />

                    <p class="mb-3">
                        <strong>Full Name:</strong><br />
                        <span class="opacity-75">
                            @Model.FirstName @Model.LastName
                        </span>
                    </p>

                    <p class="mb-3">
                        <strong>Email:</strong><br />
                        <span class="opacity-75">
                            @Model.Email
                        </span>
                    </p>

                    <p class="mb-0">
                        <strong>Address:</strong><br />
                        <span class="opacity-75">
                            @Model.Address
                        </span>
                    </p>
                </div>
            </div>

            @* Divider *@
            <div class="col-lg-1 d-none d-lg-flex justify-content-center">
                <div class="vr text-light opacity-25"></div>
            </div>

            @* Inbox *@
            <div class="col-xl-7 col-lg-6">
                <div class="h-100 text-light">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-inbox fs-4 me-2"></i>
                        <h5 class="fw-bold mb-0">Inbox</h5>
                        @if (Model.Inbox.Count(x => !x.IsRead) > 0)
                        {
                            <span class="badge bg-warning text-dark ms-2">
                              
                                YOU HAVE @Model.Inbox.Count(x => !x.IsRead) NEW MESSAGE@(Model.Inbox.Count(x => !x.IsRead) > 1 ? "S" : "")
                            </span>
                        }
                    </div>

                    <hr />

                    @if (!Model.Inbox.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-envelope-open opacity-50 fs-1"></i>
                            <p class="mt-3 mb-0 opacity-75">
                                Your inbox is empty
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var message in Model.Inbox)
                            {
                                @await Html.PartialAsync("_InboxItem", message)
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>