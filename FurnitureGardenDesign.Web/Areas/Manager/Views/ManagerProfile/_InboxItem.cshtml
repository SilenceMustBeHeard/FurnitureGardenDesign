@using FurnitureGardenDesign.Data.Common.Enums
@using FurnitureGardenDesign.Web.ViewModels.User  
@model InboxMessageViewModel

<a asp-controller="Profile"
   asp-action="MessageDetails"
   asp-route-id="@Model.Id"
   class="text-decoration-none">

    <div class="glass-list-item p-3 mb-3 message-card @(Model.IsRead ? "read" : "unread")">

        @*Date and status on top*@
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="d-flex align-items-center gap-2">
                <div class="status-dot @(Model.IsRead ? "bg-secondary" : "bg-warning")"></div>
                <small class="text-muted">
                    @Model.CreatedOn.ToLocalTime().ToString("dd MMM yyyy · HH:mm")
                </small>

                @* Message Type Badge *@
                @if (Model.Type == InboxMessageType.DesignApproved)
                {
                    <span class="badge bg-success ms-2">✓ Approved</span>
                }
                else if (Model.Type == InboxMessageType.DesignSent)
                {
                    <span class="badge bg-info ms-2">New Design</span>
                }
                else if (Model.Type == InboxMessageType.DesignRejected)
                {
                    <span class="badge bg-danger ms-2">✗ Rejected</span>
                }
                else if (Model.Type == InboxMessageType.ChangesRequested)
                {
                    <span class="badge bg-warning text-dark ms-2">↻ Changes</span>
                }
            </div>

            @if (!Model.IsRead)
            {
                <span class="unread-badge">New</span>
            }
        </div>

        @*Message Preview*@ 
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <p class="text-light mb-3 message-preview">
                @(Model.Notes.Length > 100 ? Model.Notes.Substring(0, 100) + "..." : Model.Notes)
            </p>
        }
        else
        {
            <p class="text-muted fst-italic mb-3">
                <i class="bi bi-dash"></i> No message notes
            </p>
        }

        @*Order Preview (optional - shows for admins)*@
        @if (!string.IsNullOrEmpty(Model.OrderDescription) || !string.IsNullOrEmpty(Model.OrderDimensions))
        {
            <div class="small text-muted mb-2">
                @if (!string.IsNullOrEmpty(Model.OrderDimensions))
                {
                    <span><i class="bi bi-arrows-angle-expand me-1"></i>@Model.OrderDimensions</span>
                }
            </div>
        }

        @*Action buttons (stops propagation to not trigger the link) *@
        <div class="d-flex gap-2" onclick="event.stopPropagation()">
            @if (!string.IsNullOrEmpty(Model.Model3DUrl))
            {
                <a href="@Model.Model3DUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-outline-glass btn-sm flex-fill">
                    <i class="bi bi-box-arrow-up-right me-1"></i>3D Model
                </a>
            }

            <a asp-controller="Profile"
               asp-action="MessageDetails"
               asp-route-id="@Model.Id"
               class="btn btn-primary-glass btn-sm">
                <i class="bi bi-book me-1"></i>Read Message
            </a>
        </div>
    </div>
</a>