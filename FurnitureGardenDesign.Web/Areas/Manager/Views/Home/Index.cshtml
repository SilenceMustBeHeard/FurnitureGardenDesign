@using FurnitureGardenDesign.Data.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager



@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="hero-glass">
        <h1 class="hero-title">
            Furniture and Garden Design
        </h1>

        <p class="hero-subtitle">
            AI-powered custom furniture and garden concepts.
            Designed for your space. Crafted for your style.
        </p>

        <div class="d-flex gap-3 justify-content-center mt-4">

            @if (SignInManager.IsSignedIn(User))
            {
                <a class="btn btn-primary-glass position-relative"
                   asp-controller="Catalog"
                   asp-action="CatalogIndex">
                    Explore
                </a>


                <a class="btn btn-outline-glass btn-lg"
                   asp-controller="Orders"
                   asp-action="Create">
                    New Order
                </a>
            }
            else
            {
                <a class="btn btn-primary-glass position-relative"
                   asp-controller="Catalog"
                   asp-action="CatalogIndex">
                    Explore
                </a>


                <a class="btn btn-outline-glass btn-lg"
                   asp-controller="Account"
                   asp-action="Register">
                    Create Account
                </a>
            }

        </div>

    </div>
</section>

<section class="carousel-section">
    <div id="designCarousel" class="carousel slide glass-carousel" data-bs-ride="carousel">
        <div class="carousel-inner">

            <!-- Slide 1 -->
            <div class="carousel-item active">
                <img src="~/images/sample1.jpg" class="d-block w-100" alt="Design 1">
                <div class="carousel-caption glass-caption">
                    <h5>Futuristic Gaming Deck</h5>
                    <p>When comfort and looks collide</p>
                </div>
            </div>

            <!-- Slide 2 -->
            <div class="carousel-item">
                <img src="~/images/sample2.jpg" class="d-block w-100" alt="Design 2">
                <div class="carousel-caption glass-caption">
                    <h5>Garden Lounge</h5>
                    <p>Outdoor comfort meets design</p>
                </div>
            </div>

            <!-- Slide 3 -->
            <div class="carousel-item">
                <img src="~/images/sample3.jpg" class="d-block w-100" alt="Design 3">
                <div class="carousel-caption glass-caption">
                    <h5>Minimal Shoe Rack</h5>
                    <p>Functional & elegant</p>
                </div>
            </div>

      

        </div>

        <button class="carousel-control-prev" type="button"
                data-bs-target="#designCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next" type="button"
                data-bs-target="#designCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</section>
