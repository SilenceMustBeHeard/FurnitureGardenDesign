@using FurnitureGardenDesign.Web.ViewModels.Admin.Order

@model IEnumerable<AdminOrderListViewModel>
@{
    ViewData["Title"] = "Manage Orders";
}

<div class="container mt-5">
    <div class="glass-card p-4 rounded-4 shadow-lg">

        <div class="d-flex align-items-center gap-3 mb-4 pb-2 border-bottom border-light border-opacity-10">
            <div class="glass-icon-circle">
                <i class="bi bi-box-seam fs-3" style="color: #c09a6c;"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-0">Manage Orders</h4>
                <p class="text-muted small mb-0">View and manage all pending orders</p>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <h5 class="text-muted mt-3">No pending orders</h5>
                <p class="text-muted small">All orders have been processed</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle text-light">
                    <thead class="text-muted small text-uppercase">
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Created On</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                <td>
                                    <code class="text-warning">@order.Id.ToString().Substring(0, 8)</code>
                                </td>
                                <td>@order.UserEmail</td>
                                <td>
                                    <span class="badge bg-info">@order.CategoryName</span>
                                </td>
                                <td>
                                    <div style="max-width: 250px; white-space: normal; word-break: break-word;">
                                        @order.Description
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-warning text-dark px-3 py-2">
                                        @order.Status
                                    </span>
                                </td>
                                <td>
                                    <div>@order.CreatedOn.ToString("dd.MM.yyyy")</div>
                                    <small class="text-muted">@order.CreatedOn.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn btn-outline-glass btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                                            Actions
                                        </button>
                                        <ul class="dropdown-menu" style="background: #2c221c; border: 1px solid #c09a6c40;">
                                            <li>
                                                <a asp-area="Admin"
                                                       asp-controller="OrdersManagement"
                                                       asp-action="Details"
                                                       asp-route-id="@order.Id"
                                                       class="dropdown-item text-light"
                                                       style="background: transparent;">
                                                    <i class="bi bi-eye me-2"></i> View
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider" style="border-color: #c09a6c40;"></li>
                                            <li>
                                                <form asp-area="Admin"
                                                      asp-controller="OrdersManagement"
                                                      asp-action="Reject"
                                                      asp-route-id="@order.Id"
                                                      method="post">
                                                    <button type="submit"
                                                            class="dropdown-item text-danger"
                                                            style="background: transparent;"
                                                            onclick="return confirm('Reject this order?')">
                                                        <i class="bi bi-x-circle me-2"></i> Reject
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>